{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesome-ai-tools",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awesome-ai-tools",
      "database_id": "0f8823e3-931e-4b26-8b22-f79611459aa7",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "aat_events"
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "79a56f7656f972b064b9d4ec3662b8d0",
    "ADMIN_USER_IDS": "github:2826376",
    "ANALYTICS_DATASET": "aat_events"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "CF_ANALYTICS_TOKEN", "RESEND_API_KEY"]
  },
  "env": {
    "staging": {
      "name": "awesome-ai-tools-staging",
      "triggers": {
        "crons": ["0 3 * * *"]
      },
      "assets": {
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "awesome-ai-tools-staging",
          "database_id": "b19f062f-377c-451b-afa8-82ccd05fb6ec",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "aat_events_staging"
        }
      ],
      "vars": {
        "CF_ACCOUNT_ID": "79a56f7656f972b064b9d4ec3662b8d0",
        "ADMIN_USER_IDS": "github:2826376,github:local-staging-tester",
        "ANALYTICS_DATASET": "aat_events_staging",
        "EMAIL_DRY_RUN": "1"
      },
      "secrets": {
        "required": ["GOOGLE_CLIENT_ID", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "CF_ANALYTICS_TOKEN", "RESEND_API_KEY"]
      }
    }
  }
}
