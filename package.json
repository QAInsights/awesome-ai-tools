{
  "name": "awesome-ai-tools",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "astro:dev": "bun run css:build && bun run js:build && astro dev",
    "astro:build": "bun run css:build && bun run js:build && bun scripts/assert-parser-parity.ts && node scripts/generate-og-images.js && astro build && node scripts/verify-worker-bundle.mjs",
    "astro:preview": "astro preview",
    "css:build": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "js:build": "bun run build.js",
    "build": "bun run astro:build",
    "dev": "bun run astro:dev",
    "dev:staging": "CLOUDFLARE_ENV=staging bun run astro:dev",
    "dev:js": "bun run build.js",
    "test": "bun test --isolate",
    "test:watch": "bun test --watch js/*.test.js",
    "report:enrichment": "node scripts/report-enrichment-status.js --markdown",
    "validate:slugs": "node scripts/check-slugs-sync.js",
    "validate:enriched": "bun run scripts/validate-enriched.js"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "13.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "@cloudflare/workers-types": "5.20260820.1",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "astro": "^6.1.9",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.83.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.53.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "astro-seo": "^1.1.0",
    "html2canvas": "^1.4.1",
    "jose": "6.2.9",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0"
  }
}
