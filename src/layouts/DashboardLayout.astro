---
/**
 * DashboardLayout - used by settings, help, zap, and compare pages.
 * Extends BaseLayout with the sidebar (tool variant = nav links, back button)
 * and the shared mobile header / desktop sidebar toggle chrome.
 *
 * Props:
 *   title, description - forwarded to BaseLayout
 *   activeNav - highlights the active link in the sidebar nav
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    activeNav?: 'settings' | 'zap' | 'help' | 'compare' | string;
    ogType?: string;
    ogImage?: string;
    ogImageAlt?: string;
    keywords?: string;
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
    jsonLd?: string;
    robots?: string;
    prevUrl?: string;
    nextUrl?: string;
}

const { title, activeNav, ...layoutProps } = Astro.props;
---

<BaseLayout title={title} {...layoutProps}>
    <div class="flex h-[100dvh] overflow-hidden">

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" activeNav={activeNav} title={title.replace(' | ai.dosa.dev', '').replace('ai.dosa.dev | ', '')} />

            <slot />
            <footer class="shrink-0 mt-auto px-6 md:px-8 pt-10 pb-8 text-center font-mono text-[11px] text-ink-disabled">
                ai.dosa.dev · <a href="/blog" class="hover:text-ink-secondary transition-colors">Blog</a> · <a href="/news" class="hover:text-ink-secondary transition-colors">Today in AI</a> · <a href="/advertise" class="hover:text-ink-secondary transition-colors">Advertise</a>
            </footer>
        </main>
    </div>

    <script src="/dist/dashboard.js" type="module" defer></script>
</BaseLayout>
