---
import { SEO } from 'astro-seo';
import SignInModal from '../components/SignInModal.astro';
import EthicalAd from '../components/EthicalAd.astro';
import { pageAdTopics } from '../lib/ethical-ads';
import { escapeHtml } from '../lib/html-escape';

// Base layout used by all pages
// Props: title, description, keywords, canonical, ogImage, ogType
interface Props {
    title: string;
    description?: string;
    keywords?: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogType?: string;
    /** ISO date - emitted as article:modified_time when ogType is "article" */
    modifiedTime?: string;
    /** ISO date - emitted as article:published_time when ogType is "article" */
    publishedTime?: string;
    /** Author names - emitted as article:author + <meta name="author"> */
    authors?: string[];
    /** Topic tags - emitted as article:tag when ogType is "article" */
    tags?: string[];
    ogImageAlt?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    jsonLd?: string;
    robots?: string;
    /** Markdown mirror of the page for LLM consumers - emitted as rel=alternate type=text/markdown */
    markdownUrl?: string;
    /** Paginated collections: rel=prev / rel=next hints */
    prevUrl?: string;
    nextUrl?: string;
    /** Content locale: 'en' (default) or 'zh' (Simplified Chinese). */
    lang?: string;
    /** Locale-neutral path for hreflang alternates, e.g. "/tools/cursor".
     *  Set only on pages that have both en and zh versions. */
    i18nPath?: string;
}

const {
    title,
    description = "A curated directory of artificial intelligence-powered coding tools, autonomous agents, and frameworks. Hosted by dosa.dev.",
    keywords = "AI tools, AI coding, AI IDE, autonomous agents, prompt engineering, curated list, dosa.dev",
    canonical,
    ogTitle,
    ogDescription,
    ogImage = "https://ai.dosa.dev/images/og-image.png",
    ogType = "website",
    modifiedTime,
    publishedTime,
    authors,
    tags,
    ogImageAlt,
    twitterTitle,
    twitterDescription,
    jsonLd,
    robots,
    prevUrl,
    nextUrl,
    markdownUrl,
    lang = 'en',
    i18nPath,
} = Astro.props;

const showAd = !Astro.url.pathname.startsWith('/admin');
const seoTitle = escapeHtml(title);
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
const resolvedTwitterTitle = twitterTitle ?? title;
const resolvedTwitterDesc = twitterDescription ?? description;
const resolvedOgImageAlt = ogImageAlt ?? resolvedOgTitle;
const isNoindex = robots?.includes('noindex') ?? false;
// Indexable pages opt into large image previews and unlimited snippets so
// search + answer engines can quote the page and show the OG card in full.
const robotsExtras = isNoindex
    ? undefined
    : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const articleMeta = ogType === 'article'
    ? {
        ...(publishedTime ? { publishedTime } : {}),
        ...(modifiedTime ? { modifiedTime } : {}),
        ...(authors?.length ? { authors } : {}),
        ...(tags?.length ? { tags } : {}),
    }
    : null;
const extraMeta: { name: string; content: string }[] = [
    { name: 'keywords', content: keywords },
    { name: 'author', content: authors?.length ? authors.join(', ') : 'dosa.dev' },
    { name: 'publisher', content: 'dosa.dev' },
];
const extraLinks: { rel: string; href: string; type?: string; title?: string; hreflang?: string }[] = [
    { rel: 'sitemap', type: 'application/xml', title: 'Sitemap', href: '/sitemap-index.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev Blog RSS', href: '/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'Today in AI RSS', href: '/news/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev tools RSS', href: '/tools/rss.xml' },
    { rel: 'alternate', type: 'text/plain', title: 'llms.txt', href: '/llms.txt' },
];
if (markdownUrl) extraLinks.push({ rel: 'alternate', type: 'text/markdown', title: 'Markdown', href: markdownUrl });
if (prevUrl) extraLinks.push({ rel: 'prev', href: prevUrl });
if (nextUrl) extraLinks.push({ rel: 'next', href: nextUrl });

// hreflang alternates for localized pages (en + zh-Hans + x-default → en)
if (i18nPath) {
    const enUrl = `https://ai.dosa.dev${i18nPath === '/' ? '/' : i18nPath}`;
    const zhUrl = `https://ai.dosa.dev/zh${i18nPath === '/' ? '/' : i18nPath}`;
    extraLinks.push(
        { rel: 'alternate', hreflang: 'en', href: enUrl },
        { rel: 'alternate', hreflang: 'zh-Hans', href: zhUrl },
        { rel: 'alternate', hreflang: 'x-default', href: enUrl },
    );
}
const htmlLang = lang === 'zh' ? 'zh-Hans' : 'en';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
// The snippet client appends `/chat/completions`, so keep this as the origin.
const aiSearchApiUrl = 'https://b3dd0976-27cf-4735-8aa3-279f275b235f.search.ai.cloudflare.com';
const aiSearchSnippetUrl = `${aiSearchApiUrl}/assets/v0.0.40/search-snippet.es.js`;
const aiSearchSnippetIntegrity = 'sha384-JvlvGvAgmNxIa/JqW1fKCNi+CMjrH/SG/RAtKUrHgJLf0Z6zBk5F1sSk7ZjhKo0s';
const aiSearchTranslations = JSON.stringify({
    chatTitle: 'Ask ai.dosa.dev',
    chatEmptyTitle: 'Ask the directory',
    chatEmptyDescription: 'Find the right AI coding tool, compare pricing, or explore alternatives.',
});
---
<!DOCTYPE html>
<html lang={htmlLang}>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <SEO
      title={seoTitle}
      description={description}
      canonical={resolvedCanonical}
      openGraph={{
        basic: {
          title: resolvedOgTitle,
          type: ogType,
          image: ogImage,
        },
        optional: {
          description: resolvedOgDesc,
          siteName: "ai.dosa.dev",
          locale: ogLocale,
        },
        image: {
          width: 1200,
          height: 630,
          alt: resolvedOgImageAlt,
          type: "image/png",
        },
        ...(articleMeta && Object.keys(articleMeta).length
          ? { article: articleMeta }
          : {}),
      }}
      twitter={{
        card: "summary_large_image",
        site: "@dosadev",
        creator: "@dosadev",
        title: resolvedTwitterTitle,
        description: resolvedTwitterDesc,
        image: ogImage,
        imageAlt: resolvedOgImageAlt,
      }}
      noindex={isNoindex}
      nofollow={robots?.includes('nofollow')}
      robotsExtras={robotsExtras}
      extend={{
        meta: extraMeta,
        link: extraLinks,
      }}
    />

    {/* Fonts are self-hosted (see input.css @font-face) - no third-party font connections */}

    <link rel="icon" type="image/png" href="/images/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/favicon.svg" />
    <link rel="shortcut icon" href="/images/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/images/icons/site.webmanifest" />

    <link rel="stylesheet" href="/css/output.css">
    <style is:inline>
        chat-bubble-snippet {
            color-scheme: dark;
            --search-snippet-font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
            --search-snippet-primary-color: #f2c040;
            --search-snippet-primary-hover: #f1d99f;
            --search-snippet-background: #0a0a0a;
            --search-snippet-surface: #111111;
            --search-snippet-hover-background: #171717;
            --search-snippet-text-color: #ffffff;
            --search-snippet-text-secondary: #a3a3a3;
            --search-snippet-text-description: #d4d4d4;
            --search-snippet-border-color: #222222;
            --search-snippet-focus-ring: rgba(242, 192, 64, 0.28);
            --search-snippet-user-message-bg: #f2c040;
            --search-snippet-user-message-text: #000000;
            --search-snippet-assistant-message-bg: #171717;
            --search-snippet-assistant-message-text: #e5e5e5;
            --chat-bubble-button-icon-color: #000000;
            --chat-bubble-button-shadow: 0 12px 32px rgba(242, 192, 64, 0.2);
            --chat-bubble-window-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
        }
    </style>

    {/* Escape `<` so enriched free-text can never close the script tag early */}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd.replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <slot name="head" />
</head>

<body class="bg-black text-white font-sans antialiased leading-relaxed">
    <slot />

    {showAd && <EthicalAd keywords={pageAdTopics(tags, keywords)} />}
    <SignInModal />
    <div id="turnstile-container"></div>
    <script src="/dist/site-analytics.js" type="module" defer></script>
    <script src="/dist/onboarding.js" type="module" defer></script>
    <script src="/dist/one-tap.js" type="module" defer></script>
    <!-- Cloudflare AI Search chat bubble -->
    <script
        type="module"
        src={aiSearchSnippetUrl}
        integrity={aiSearchSnippetIntegrity}
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
        fetchpriority="low"
    ></script>
    <chat-bubble-snippet
        api-url={aiSearchApiUrl}
        theme="dark"
        hide-branding="true"
        placeholder="Ask about AI coding tools..."
        translations={aiSearchTranslations}
    ></chat-bubble-snippet>
    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "16936e2eed2a4361adb21441d23573dd"}'></script>
    <!-- End Cloudflare Web Analytics -->
</body>

</html>
