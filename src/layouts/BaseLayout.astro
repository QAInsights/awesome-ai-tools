---
import { SEO } from 'astro-seo';
import SignInModal from '../components/SignInModal.astro';

// Base layout used by all pages
// Props: title, description, keywords, canonical, ogImage, ogType
interface Props {
    title: string;
    description?: string;
    keywords?: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogType?: string;
    /** ISO date - emitted as article:modified_time when ogType is "article" */
    modifiedTime?: string;
    /** ISO date - emitted as article:published_time when ogType is "article" */
    publishedTime?: string;
    /** Author names - emitted as article:author + <meta name="author"> */
    authors?: string[];
    /** Topic tags - emitted as article:tag when ogType is "article" */
    tags?: string[];
    ogImageAlt?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    jsonLd?: string;
    robots?: string;
    /** Paginated collections: rel=prev / rel=next hints */
    prevUrl?: string;
    nextUrl?: string;
}

const {
    title,
    description = "A curated directory of artificial intelligence-powered coding tools, autonomous agents, and frameworks. Hosted by dosa.dev.",
    keywords = "AI tools, AI coding, AI IDE, autonomous agents, prompt engineering, curated list, dosa.dev",
    canonical,
    ogTitle,
    ogDescription,
    ogImage = "https://ai.dosa.dev/images/og-image.png",
    ogType = "website",
    modifiedTime,
    publishedTime,
    authors,
    tags,
    ogImageAlt,
    twitterTitle,
    twitterDescription,
    jsonLd,
    robots,
    prevUrl,
    nextUrl,
} = Astro.props;

const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
const resolvedTwitterTitle = twitterTitle ?? title;
const resolvedTwitterDesc = twitterDescription ?? description;
const resolvedOgImageAlt = ogImageAlt ?? resolvedOgTitle;
const isNoindex = robots?.includes('noindex') ?? false;
// Indexable pages opt into large image previews and unlimited snippets so
// search + answer engines can quote the page and show the OG card in full.
const robotsExtras = isNoindex
    ? undefined
    : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const articleMeta = ogType === 'article'
    ? {
        ...(publishedTime ? { publishedTime } : {}),
        ...(modifiedTime ? { modifiedTime } : {}),
        ...(authors?.length ? { authors } : {}),
        ...(tags?.length ? { tags } : {}),
    }
    : null;
const extraMeta: { name: string; content: string }[] = [
    { name: 'keywords', content: keywords },
    { name: 'author', content: authors?.length ? authors.join(', ') : 'dosa.dev' },
    { name: 'publisher', content: 'dosa.dev' },
];
const extraLinks: { rel: string; href: string; type?: string; title?: string }[] = [
    { rel: 'sitemap', type: 'application/xml', title: 'Sitemap', href: '/sitemap-index.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev Blog RSS', href: '/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'Today in AI RSS', href: '/news/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev tools RSS', href: '/tools/rss.xml' },
    { rel: 'alternate', type: 'text/plain', title: 'llms.txt', href: '/llms.txt' },
];
if (prevUrl) extraLinks.push({ rel: 'prev', href: prevUrl });
if (nextUrl) extraLinks.push({ rel: 'next', href: nextUrl });
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <SEO
      title={title}
      description={description}
      canonical={resolvedCanonical}
      openGraph={{
        basic: {
          title: resolvedOgTitle,
          type: ogType,
          image: ogImage,
        },
        optional: {
          description: resolvedOgDesc,
          siteName: "ai.dosa.dev",
          locale: "en_US",
        },
        image: {
          width: 1200,
          height: 630,
          alt: resolvedOgImageAlt,
          type: "image/png",
        },
        ...(articleMeta && Object.keys(articleMeta).length
          ? { article: articleMeta }
          : {}),
      }}
      twitter={{
        card: "summary_large_image",
        site: "@dosadev",
        creator: "@dosadev",
        title: resolvedTwitterTitle,
        description: resolvedTwitterDesc,
        image: ogImage,
        imageAlt: resolvedOgImageAlt,
      }}
      noindex={isNoindex}
      nofollow={robots?.includes('nofollow')}
      robotsExtras={robotsExtras}
      extend={{
        meta: extraMeta,
        link: extraLinks,
      }}
    />

    {/* Fonts are self-hosted (see input.css @font-face) - no third-party font connections */}

    <link rel="icon" type="image/png" href="/images/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/favicon.svg" />
    <link rel="shortcut icon" href="/images/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/images/icons/site.webmanifest" />

    <link rel="stylesheet" href="/css/output.css">

    {/* Escape `<` so enriched free-text can never close the script tag early */}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd.replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <slot name="head" />
</head>

<body class="bg-black text-white font-sans antialiased leading-relaxed">
    <slot />

    <SignInModal />
    <div id="turnstile-container"></div>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
    <script src="/dist/site-analytics.js" type="module" defer></script>
    <script src="/dist/onboarding.js" type="module" defer></script>
    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "16936e2eed2a4361adb21441d23573dd"}'></script>
    <!-- End Cloudflare Web Analytics -->
</body>

</html>
