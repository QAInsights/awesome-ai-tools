---
import { SEO } from 'astro-seo';
import SignInModal from '../components/SignInModal.astro';
import EthicalAd from '../components/EthicalAd.astro';
import { pageAdTopics } from '../lib/ethical-ads';
import { escapeHtml } from '../lib/html-escape';

// Base layout used by all pages
// Props: title, description, keywords, canonical, ogImage, ogType
interface Props {
    title: string;
    description?: string;
    keywords?: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogType?: string;
    /** ISO date - emitted as article:modified_time when ogType is "article" */
    modifiedTime?: string;
    /** ISO date - emitted as article:published_time when ogType is "article" */
    publishedTime?: string;
    /** Author names - emitted as article:author + <meta name="author"> */
    authors?: string[];
    /** Topic tags - emitted as article:tag when ogType is "article" */
    tags?: string[];
    ogImageAlt?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    jsonLd?: string;
    robots?: string;
    /** Markdown mirror of the page for LLM consumers - emitted as rel=alternate type=text/markdown */
    markdownUrl?: string;
    /** Paginated collections: rel=prev / rel=next hints */
    prevUrl?: string;
    nextUrl?: string;
    /** Content locale: 'en' (default) or 'zh' (Simplified Chinese). */
    lang?: string;
    /** Locale-neutral path for hreflang alternates, e.g. "/tools/cursor".
     *  Set only on pages that have both en and zh versions. */
    i18nPath?: string;
}

const {
    title,
    description = "A curated directory of artificial intelligence-powered coding tools, autonomous agents, and frameworks. Hosted by dosa.dev.",
    keywords = "AI tools, AI coding, AI IDE, autonomous agents, prompt engineering, curated list, dosa.dev",
    canonical,
    ogTitle,
    ogDescription,
    ogImage = "https://ai.dosa.dev/images/og-image.png",
    ogType = "website",
    modifiedTime,
    publishedTime,
    authors,
    tags,
    ogImageAlt,
    twitterTitle,
    twitterDescription,
    jsonLd,
    robots,
    prevUrl,
    nextUrl,
    markdownUrl,
    lang = 'en',
    i18nPath,
} = Astro.props;

const showAd = !Astro.url.pathname.startsWith('/admin');
const seoTitle = escapeHtml(title);
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
const resolvedTwitterTitle = twitterTitle ?? title;
const resolvedTwitterDesc = twitterDescription ?? description;
const resolvedOgImageAlt = ogImageAlt ?? resolvedOgTitle;
const isNoindex = robots?.includes('noindex') ?? false;
// Indexable pages opt into large image previews and unlimited snippets so
// search + answer engines can quote the page and show the OG card in full.
const robotsExtras = isNoindex
    ? undefined
    : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const articleMeta = ogType === 'article'
    ? {
        ...(publishedTime ? { publishedTime } : {}),
        ...(modifiedTime ? { modifiedTime } : {}),
        ...(authors?.length ? { authors } : {}),
        ...(tags?.length ? { tags } : {}),
    }
    : null;
const extraMeta: { name: string; content: string }[] = [
    { name: 'keywords', content: keywords },
    { name: 'author', content: authors?.length ? authors.join(', ') : 'dosa.dev' },
    { name: 'publisher', content: 'dosa.dev' },
];
const extraLinks: { rel: string; href: string; type?: string; title?: string; hreflang?: string }[] = [
    { rel: 'sitemap', type: 'application/xml', title: 'Sitemap', href: '/sitemap-index.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev Blog RSS', href: '/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'Today in AI RSS', href: '/news/rss.xml' },
    { rel: 'alternate', type: 'application/rss+xml', title: 'ai.dosa.dev tools RSS', href: '/tools/rss.xml' },
    { rel: 'alternate', type: 'text/plain', title: 'llms.txt', href: '/llms.txt' },
];
if (markdownUrl) extraLinks.push({ rel: 'alternate', type: 'text/markdown', title: 'Markdown', href: markdownUrl });
if (prevUrl) extraLinks.push({ rel: 'prev', href: prevUrl });
if (nextUrl) extraLinks.push({ rel: 'next', href: nextUrl });

// hreflang alternates for localized pages (en + zh-Hans + x-default → en)
if (i18nPath) {
    const enUrl = `https://ai.dosa.dev${i18nPath === '/' ? '/' : i18nPath}`;
    const zhUrl = `https://ai.dosa.dev/zh${i18nPath === '/' ? '/' : i18nPath}`;
    extraLinks.push(
        { rel: 'alternate', hreflang: 'en', href: enUrl },
        { rel: 'alternate', hreflang: 'zh-Hans', href: zhUrl },
        { rel: 'alternate', hreflang: 'x-default', href: enUrl },
    );
}
const htmlLang = lang === 'zh' ? 'zh-Hans' : 'en';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
// The snippet client appends `/chat/completions`, so keep this as the origin.
const aiSearchApiUrl = 'https://b3dd0976-27cf-4735-8aa3-279f275b235f.search.ai.cloudflare.com';
const aiSearchSnippetUrl = `${aiSearchApiUrl}/assets/v0.0.40/search-snippet.es.js`;
const aiSearchSnippetIntegrity = 'sha384-JvlvGvAgmNxIa/JqW1fKCNi+CMjrH/SG/RAtKUrHgJLf0Z6zBk5F1sSk7ZjhKo0s';
const aiSearchTranslations = JSON.stringify({
    chatTitle: 'Ask ai.dosa.dev',
    chatEmptyTitle: 'Ask the directory',
    chatEmptyDescription: 'Find the right AI coding tool, compare pricing, or explore alternatives.',
});
---
<!DOCTYPE html>
<html lang={htmlLang}>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <SEO
      title={seoTitle}
      description={description}
      canonical={resolvedCanonical}
      openGraph={{
        basic: {
          title: resolvedOgTitle,
          type: ogType,
          image: ogImage,
        },
        optional: {
          description: resolvedOgDesc,
          siteName: "ai.dosa.dev",
          locale: ogLocale,
        },
        image: {
          width: 1200,
          height: 630,
          alt: resolvedOgImageAlt,
          type: "image/png",
        },
        ...(articleMeta && Object.keys(articleMeta).length
          ? { article: articleMeta }
          : {}),
      }}
      twitter={{
        card: "summary_large_image",
        site: "@dosadev",
        creator: "@dosadev",
        title: resolvedTwitterTitle,
        description: resolvedTwitterDesc,
        image: ogImage,
        imageAlt: resolvedOgImageAlt,
      }}
      noindex={isNoindex}
      nofollow={robots?.includes('nofollow')}
      robotsExtras={robotsExtras}
      extend={{
        meta: extraMeta,
        link: extraLinks,
      }}
    />

    {/* Fonts are self-hosted (see input.css @font-face) - no third-party font connections */}

    <link rel="icon" type="image/png" href="/images/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/favicon.svg" />
    <link rel="shortcut icon" href="/images/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/images/icons/site.webmanifest" />

    <link rel="stylesheet" href="/css/output.css">
    <style is:inline>
        chat-bubble-snippet {
            color-scheme: dark;
            --search-snippet-font-family: var(--font-sans);
            --search-snippet-primary-color: var(--color-gold);
            --search-snippet-primary-hover: var(--color-gold-hi);
            --search-snippet-background: var(--color-panel);
            --search-snippet-surface: rgb(255 255 255 / 0.02);
            --search-snippet-hover-background: rgb(255 255 255 / 0.05);
            --search-snippet-text-color: var(--color-ink);
            --search-snippet-text-secondary: var(--color-ink-secondary);
            --search-snippet-text-description: var(--color-ink-secondary);
            --search-snippet-border-color: var(--color-border);
            --search-snippet-focus-ring: color-mix(in srgb, var(--color-gold) 28%, transparent);
            --search-snippet-user-message-bg: var(--color-gold);
            --search-snippet-user-message-text: var(--color-page);
            --search-snippet-assistant-message-bg: rgb(255 255 255 / 0.05);
            --search-snippet-assistant-message-text: var(--color-ink);
            --chat-bubble-button-icon-color: var(--color-page);
            --chat-bubble-button-bottom: calc(20px + env(safe-area-inset-bottom, 0px));
            --chat-bubble-button-right: calc(20px + env(safe-area-inset-right, 0px));
            --chat-bubble-button-z-index: 20;
        }

        body:has([data-ea-style="fixedfooter"].loaded) chat-bubble-snippet {
            --chat-bubble-button-bottom: calc(var(--ea-float-h, 0px) + 20px + env(safe-area-inset-bottom, 0px));
        }

        @media (max-width: 767px) {
            chat-bubble-snippet {
                --chat-bubble-button-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
            }

            body:has([data-ea-style="fixedfooter"].loaded) chat-bubble-snippet {
                --chat-bubble-button-bottom: calc(var(--ea-float-h, 0px) + 72px + env(safe-area-inset-bottom, 0px));
            }
        }

        body:has(#compareFloatingBar[data-visible="true"]) chat-bubble-snippet {
            --chat-bubble-button-bottom: calc(var(--ea-float-h, 0px) + var(--compare-bar-h, 0px) + 20px + env(safe-area-inset-bottom, 0px));
        }

        @media (min-width: 1301px) {
            body:has([data-ea-style="stickybox"].loaded) chat-bubble-snippet {
                --chat-bubble-button-right: calc(220px + env(safe-area-inset-right, 0px));
            }
        }
    </style>

    {/* Escape `<` so enriched free-text can never close the script tag early */}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd.replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <slot name="head" />
</head>

<body class="bg-black text-white font-sans antialiased leading-relaxed">
    <slot />

    {showAd && <EthicalAd keywords={pageAdTopics(tags, keywords)} />}
    <SignInModal />
    <div id="turnstile-container"></div>
    <script src="/dist/site-analytics.js" type="module" defer></script>
    <script src="/dist/onboarding.js" type="module" defer></script>
    <script src="/dist/one-tap.js" type="module" defer></script>
    <!-- Cloudflare AI Search chat bubble -->
    <script
        type="module"
        src={aiSearchSnippetUrl}
        integrity={aiSearchSnippetIntegrity}
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
        fetchpriority="low"
    ></script>
    <chat-bubble-snippet
        api-url={aiSearchApiUrl}
        theme="dark"
        hide-branding="true"
        placeholder="Ask about AI coding tools..."
        translations={aiSearchTranslations}
    ></chat-bubble-snippet>
    <!-- v0.0.40 parses the translations attribute but does not forward it to ChatView. -->
    <script is:inline>
        (() => {
            let observedChatWidget = null;
            let chatWidgetObserver = null;

            const syncChatWindowState = (chat) => {
                const chatWidget = chat.shadowRoot?.querySelector('.chat-bubble-widget');
                const chatWindow = chatWidget?.querySelector('.chat-window');
                if (!chatWidget || !chatWindow) return;
                const syncInertState = () => {
                    const expanded = chatWindow.classList.contains('expanded');
                    chatWindow.inert = !expanded;
                    const inactive = !expanded || chatWindow.classList.contains('minimized');
                    chatWindow.querySelectorAll('.chat-content, .powered-by').forEach((region) => {
                        region.inert = inactive;
                    });
                    const bubbleButton = chatWidget.querySelector('.bubble-button');
                    if (bubbleButton) {
                        bubbleButton.inert = bubbleButton.classList.contains('hidden');
                    }
                };
                syncInertState();
                if (observedChatWidget !== chatWidget) {
                    chatWidgetObserver?.disconnect();
                    observedChatWidget = chatWidget;
                    chatWidgetObserver = new MutationObserver(syncInertState);
                    chatWidgetObserver.observe(chatWidget, { attributes: true, subtree: true, attributeFilter: ['class'] });
                }
            };

            // v0.0.40 is SRI-pinned, so these open-shadow selectors cannot drift.
            const patchShadowDom = (chat) => {
                if (!chat?.shadowRoot) return;
                if (!chat.shadowRoot.querySelector('[data-ai-search-compat]')) {
                    const style = document.createElement('style');
                    style.dataset.aiSearchCompat = '';
                    style.textContent = `
                        .chat-window {
                            visibility: hidden;
                            max-height: calc(100dvh - var(--chat-bubble-button-bottom) - 12px - env(safe-area-inset-top, 0px));
                            transition: opacity 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55), transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55), visibility 0s linear 0.3s;
                        }
                        .chat-window.expanded {
                            visibility: visible;
                            transition: opacity 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55), transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55), visibility 0s;
                        }
                    `;
                    chat.shadowRoot.appendChild(style);
                }
                syncChatWindowState(chat);
            };

            const patchKeyboard = (chat) => {
                if (!chat?.shadowRoot || chat.dataset.aiSearchKeyboardPatched === 'true') return;
                chat.dataset.aiSearchKeyboardPatched = 'true';
                let lastCompositionEndAt = null;
                chat.shadowRoot.addEventListener('compositionend', (event) => {
                    if (event.target?.classList?.contains('chat-input')) {
                        lastCompositionEndAt = event.timeStamp;
                    }
                }, true);
                chat.shadowRoot.addEventListener('keydown', (event) => {
                    if (event.key !== 'Enter' || event.shiftKey) return;
                    if (!event.target?.classList?.contains('chat-input')) return;
                    const endedCompositionJustNow = lastCompositionEndAt !== null && Math.abs(event.timeStamp - lastCompositionEndAt) < 50;
                    if (event.isComposing || event.keyCode === 229 || endedCompositionJustNow) {
                        event.preventDefault();
                        event.stopImmediatePropagation();
                    }
                }, true);
            };

            const applyCompatibilityFixes = () => {
                const chat = document.querySelector('chat-bubble-snippet');
                if (!chat) return;
                try {
                    chat.translations = JSON.parse(chat.getAttribute('translations') || '{}');
                } catch {}
                patchShadowDom(chat);
                patchKeyboard(chat);
                if (!chat.dataset.aiSearchObserverPatched && chat.shadowRoot) {
                    chat.dataset.aiSearchObserverPatched = 'true';
                    new MutationObserver(() => patchShadowDom(chat)).observe(chat.shadowRoot, { childList: true });
                }
            };

            if (customElements.get('chat-bubble-snippet')) {
                applyCompatibilityFixes();
            } else {
                customElements.whenDefined('chat-bubble-snippet').then(applyCompatibilityFixes);
            }
        })();
    </script>
    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "16936e2eed2a4361adb21441d23573dd"}'></script>
    <!-- End Cloudflare Web Analytics -->
</body>

</html>
