---
interface Props {
  isNewsPost?: boolean;
  subject?: string;
  compact?: boolean;
  class?: string;
}

const {
  isNewsPost = false,
  subject = 'today-in-ai',
  compact = false,
  class: className,
} = Astro.props;

const eyebrow = isNewsPost ? 'Daily AI Brief' : 'Stay in the Loop';
const heading = isNewsPost
  ? 'Get Today in AI in your inbox'
  : 'Get the daily AI brief for builders';
const copy = isNewsPost
  ? 'One-click email subscription for model releases, tooling updates, and funding moves, delivered when a new edition lands.'
  : 'Receive our daily Today in AI brief and new deep-dive posts by email. Unsubscribe anytime.';
---

<aside
  aria-label="Subscribe to daily AI brief"
  class:list={[
    'rounded-xl border border-[#262626] bg-gradient-to-br from-[#141414] via-[#101010] to-[#0c181b] relative overflow-hidden',
    compact ? 'p-4 sm:p-5' : 'p-5 sm:p-6 mt-10',
    className,
  ]}
>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="min-w-0">
      <div class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-widest text-[#22d3ee] mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[#22d3ee]"></span>
        {eyebrow}
      </div>
      <h2 class="text-base sm:text-lg font-semibold text-white tracking-tight">
        {heading}
      </h2>
      <p class="text-[14px] text-[#a3a3a3] leading-relaxed mt-1 max-w-xl">
        {copy}
      </p>
    </div>

    <div class="flex flex-col sm:items-end gap-1.5 shrink-0">
      <button
        type="button"
        data-news-subscribe
        data-subscribe-default="Get daily brief by email"
        data-subscribe-active="Subscribed to daily brief"
        data-subscribe-subject={subject}
        aria-pressed="false"
        class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-lg border border-[#22d3ee]/40 bg-[#22d3ee]/10 text-[#67e8f9] hover:bg-[#22d3ee]/20 hover:border-[#22d3ee]/60 transition-colors text-[13px] font-mono font-medium cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span data-subscribe-label>Get daily brief by email</span>
      </button>
      <p
        data-news-subscribe-status
        class="hidden text-[12px] font-mono text-[#8a8a8a]"
        aria-live="polite"
      ></p>
    </div>
  </div>
</aside>
