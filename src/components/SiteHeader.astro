---
import NavIsland from './NavIsland.astro';

interface Props {
    variant: 'index' | 'page';
    title?: string;
    activeNav?: string;
}

const { variant, title = 'ai.dosa.dev', activeNav } = Astro.props;
const isIndex = variant === 'index';
---

<NavIsland activeNav={activeNav} search={!isIndex} />

<div class="border-b border-border bg-black/80 backdrop-blur-xl sticky top-0 z-20">
    <div class:list={['flex items-center gap-3 h-14 md:h-16 px-4 md:px-8', isIndex && 'border-b border-border']}>
        <a href="/" class="group flex items-center gap-2.5 md:gap-3 no-underline min-w-0">
            <img src="/images/icons/favicon-96x96.png" alt="dosa.dev logo" width="28" height="28" fetchpriority="high" decoding="async" class="shrink-0 w-6 h-6 md:w-7 md:h-7 transition-transform duration-300 group-hover:scale-105" />
            {isIndex
                ? <h1 class="text-[17px] md:text-[18px] font-semibold tracking-wide text-white m-0 leading-none">ai.dosa.dev <span class="sr-only">- Awesome AI Coding Tools Directory</span></h1>
                : <span class="min-w-0"><span class="md:hidden block text-[17px] font-semibold tracking-wide text-white leading-none truncate">{title}</span><span class="hidden md:block text-[18px] font-semibold tracking-wide text-white leading-none">ai.dosa.dev</span></span>
            }
        </a>
        <div id="authHeader" class="flex items-center gap-3 shrink-0 ml-auto">
            <a href="/advertise" title="Sponsor the Featured slot on ai.dosa.dev" class="hidden xl:inline-flex items-center gap-2 px-4 py-2 border border-border rounded-full text-sm font-medium text-ink-secondary hover:text-white hover:bg-white/5 hover:border-border-strong transition-all whitespace-nowrap">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg>
                <span>Advertise</span>
            </a>
            <a href="https://github.com/QAInsights/awesome-ai-tools/issues/new?template=submit-tool.yml" target="_blank" rel="noopener noreferrer" class="hidden xl:inline-flex items-center gap-1.5 px-4 py-2 border border-border rounded-full text-sm font-medium text-ink-secondary hover:text-white hover:bg-white/5 hover:border-border-strong transition-all whitespace-nowrap">
                <span aria-hidden="true">+</span>
                <span>Submit</span>
            </a>
            <button id="signInTriggerBtn" class="hidden px-4 md:px-5 py-2 bg-white text-black rounded-full text-sm font-semibold hover:bg-gray-200 transition-all active:scale-[0.98] whitespace-nowrap">
                <span class="hidden md:inline">Sign in</span>
                <svg class="md:hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </button>

            <div id="userProfile" class="hidden relative">
                <div id="userProfileBtn" class="flex items-center gap-2.5 pl-1.5 pr-3 py-1.5 bg-white/[0.03] rounded-full border border-border cursor-pointer hover:bg-white/10 transition-all hover:border-border-strong">
                    <img id="userAvatar" src="" alt="User" class="w-7 h-7 rounded-full border border-white/10">
                    <span id="userName" class="text-sm font-medium text-white max-w-[120px] truncate hidden md:inline"></span>
                    <svg class="w-4 h-4 text-ink-disabled" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>

                <div id="userMenuPopup" class="hidden absolute top-[calc(100%+8px)] right-0 w-56 bg-panel border border-border rounded-xl shadow-2xl z-50 py-1.5 overflow-hidden transform origin-top-right transition-all">
                    <div class="px-4 py-2 border-b border-border mb-1">
                        <div id="userEmail" class="text-[11px] text-ink-disabled truncate"></div>
                    </div>
                    <a href="/favorites" class="flex items-center px-4 py-2.5 text-[14px] text-ink-secondary hover:text-white hover:bg-white/5 transition-colors">Favorites</a>
                    <a href="/stacks" class="flex items-center px-4 py-2.5 text-[14px] text-ink-secondary hover:text-white hover:bg-white/5 transition-colors">My stacks</a>
                    <a href="/zap" class="flex items-center px-4 py-2.5 text-[14px] text-ink-secondary hover:text-white hover:bg-white/5 transition-colors">Zap Dashboard</a>
                    <a href="/settings" class="flex items-center px-4 py-2.5 text-[14px] text-ink-secondary hover:text-white hover:bg-white/5 transition-colors">Settings</a>
                    <a href="/badge" id="getBadgeMenuBtn" class="w-full text-left flex items-center px-4 py-2.5 text-[14px] text-ink-secondary hover:text-white hover:bg-white/5 transition-colors">Get Badge</a>
                    <div class="h-px bg-border my-1.5"></div>
                    <button id="signOutBtn" class="w-full text-left flex items-center px-4 py-2.5 text-[14px] text-danger hover:bg-danger/10 transition-colors">Sign Out</button>
                </div>
            </div>
        </div>
    </div>
    {isIndex && (
        <div class="flex items-center gap-3 md:gap-4 px-4 md:px-8 py-3 md:py-4">
            <div class="search-shell relative max-w-[560px] w-full group">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6f6a63] group-focus-within:text-[#d6c7a8] w-4.5 h-4.5 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="searchInput" placeholder="Search tools, agents, and workflows" autocomplete="off" class="search-input w-full rounded-2xl text-[15px] outline-none transition-all duration-300">
                <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center gap-2">
                    <button class="bg-transparent border-none text-ink-muted text-sm cursor-pointer p-1 hidden hover:text-white" id="searchClear" aria-label="Clear search" title="Clear search">&#x2715;</button>
                    <span class="search-shortcut hidden md:inline-flex" aria-hidden="true">/</span>
                    <span id="resultCount" class="search-result-count font-mono text-[10px] hidden md:block"></span>
                </div>
            </div>

            <slot />

        </div>
    )}
    <slot name="overlay" />
</div>
