---
interface Props {
    variant: 'index' | 'page';
    title?: string;
}

const { variant, title = 'ai.dosa.dev' } = Astro.props;
---

<div class="md:hidden flex items-center justify-between p-4 border-b border-[#222] bg-[#0a0a0a] shrink-0 z-10 sticky top-0">
    <div class="flex items-center gap-3">
        <button id="openSidebarMobile" aria-label="Open sidebar menu" class="text-[#a3a3a3] hover:text-white transition-colors p-1 rounded-md hover:bg-white/5">
            <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div class="flex items-center gap-2">
            <img src="/images/icons/favicon-32x32.png" alt="logo" class="w-6 h-6 rounded-full" />
            <span class="text-[17px] font-semibold tracking-wide text-white leading-none truncate">{title}</span>
        </div>
    </div>
</div>

<div id="desktopToggleContainer" class="hidden absolute top-[14px] left-4 z-20 transition-opacity duration-300">
    <button id="openSidebarDesktop" aria-label="Open sidebar" class="text-[#a3a3a3] hover:text-white p-1.5 bg-[#0a0a0a] border border-[#222] rounded-md shadow-sm transition-all hover:bg-white/5 backdrop-blur-sm" title="Open sidebar">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
    </button>
</div>

<div class="px-4 md:px-8 py-4 md:py-5 border-b border-[#222] bg-black/80 backdrop-blur-xl sticky top-0 z-20">
    <div class="flex items-center gap-3 md:gap-4">
        {variant === 'index' ? (
            <div class="search-shell relative max-w-[560px] w-full group">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6f6a63] group-focus-within:text-[#d6c7a8] w-4.5 h-4.5 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="searchInput" placeholder="Search tools, agents, and workflows" autocomplete="off" class="search-input w-full rounded-2xl text-[15px] outline-none transition-all duration-300">
                <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center gap-2">
                    <button class="bg-transparent border-none text-[#737373] text-sm cursor-pointer p-1 hidden hover:text-white" id="searchClear" aria-label="Clear search" title="Clear search">&#x2715;</button>
                    <span class="search-shortcut hidden md:inline-flex" aria-hidden="true">/</span>
                    <span id="resultCount" class="search-result-count font-mono text-[10px] hidden md:block"></span>
                </div>
            </div>
        ) : (
            <form action="/" method="get" role="search" class="search-shell relative max-w-[560px] w-full group">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6f6a63] group-focus-within:text-[#d6c7a8] w-4.5 h-4.5 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="search" name="q" id="globalSearchInput" placeholder="Search tools, agents, and workflows" autocomplete="off" class="search-input w-full rounded-2xl text-[15px] outline-none transition-all duration-300">
                <span class="search-shortcut hidden md:inline-flex absolute right-3.5 top-1/2 -translate-y-1/2" aria-hidden="true">/</span>
            </form>
        )}

        {variant === 'index' && <slot />}

        <div id="authHeader" class="flex items-center gap-4 shrink-0 ml-auto">
            <button id="signInTriggerBtn" class="hidden px-4 md:px-5 py-2.5 bg-white text-black rounded-full text-sm font-semibold hover:bg-gray-200 transition-all active:scale-[0.98] whitespace-nowrap">
                <span class="hidden md:inline">Sign in</span>
                <svg class="md:hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </button>

            <div id="userProfile" class="hidden relative">
                <div id="userProfileBtn" class="flex items-center gap-2.5 pl-1.5 pr-3 py-1.5 bg-white/[0.03] rounded-full border border-[#222] cursor-pointer hover:bg-white/10 transition-all hover:border-[#444]">
                    <img id="userAvatar" src="" alt="User" class="w-7 h-7 rounded-full border border-white/10">
                    <span id="userName" class="text-sm font-medium text-white max-w-[120px] truncate hidden md:inline"></span>
                    <svg class="w-4 h-4 text-[#525252]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>

                <div id="userMenuPopup" class="hidden absolute top-[calc(100%+8px)] right-0 w-56 bg-[#0a0a0a] border border-[#222] rounded-xl shadow-2xl z-50 py-1.5 overflow-hidden transform origin-top-right transition-all">
                    <div class="px-4 py-2 border-b border-[#222] mb-1">
                        <div id="userEmail" class="text-[11px] text-[#525252] truncate"></div>
                    </div>
                    <a href="/favorites" class="flex items-center px-4 py-2.5 text-[14px] text-[#a3a3a3] hover:text-white hover:bg-white/5 transition-colors">Favorites</a>
                    <a href="/zap" class="flex items-center px-4 py-2.5 text-[14px] text-[#a3a3a3] hover:text-white hover:bg-white/5 transition-colors">Zap Dashboard</a>
                    <a href="/settings" class="flex items-center px-4 py-2.5 text-[14px] text-[#a3a3a3] hover:text-white hover:bg-white/5 transition-colors">Settings</a>
                    <button id="getBadgeMenuBtn" class="w-full text-left flex items-center px-4 py-2.5 text-[14px] text-[#a3a3a3] hover:text-white hover:bg-white/5 transition-colors">Get Badge</button>
                    <div class="h-px bg-[#222] my-1.5"></div>
                    <button id="signOutBtn" class="w-full text-left flex items-center px-4 py-2.5 text-[14px] text-red-400 hover:bg-red-400/10 transition-colors">Sign Out</button>
                </div>
            </div>
        </div>
    </div>
</div>
