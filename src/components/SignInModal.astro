<div id="signInModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div id="signInModalOverlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>
    <div class="relative bg-[#0d0d0d] border border-border rounded-[32px] p-8 w-full max-w-sm shadow-[0_40px_80px_-15px_rgba(0,0,0,0.9)] transform transition-all duration-300">
        <button id="closeSignInModal" class="absolute top-6 right-6 text-ink-disabled hover:text-white transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="mb-8">
            <h3 class="text-xl font-bold text-white mb-2 text-center">Track your AI stack</h3>
            <ul class="text-ink-secondary text-sm flex flex-col gap-2.5 mt-4">
                <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 shrink-0 text-gold-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4.5 13.5H11L10 22L19.5 10.5H13L13 2Z"/></svg>
                    Zap tools to vote - public counts surface the best
                </li>
                <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 shrink-0 text-gold-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                    Sync your bookmarks across devices
                </li>
                <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 shrink-0 text-gold-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-3.5-3.5a1.4 1.4 0 0 0 2 0L6 21"/></svg>
                    Revisit saved tools from your Favorites page
                </li>
            </ul>
        </div>
        <div class="flex flex-col gap-4">
            <div id="googleSignInBtn" class="w-full min-h-[44px]"></div>
            <div id="githubSignInBtn" class="w-full min-h-[44px]"></div>
            <div id="devSignInBtn" class="w-full min-h-[44px] empty:hidden"></div>
        </div>
    </div>
</div>
