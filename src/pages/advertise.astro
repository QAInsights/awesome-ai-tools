---
/**
 * /advertise - sponsorship landing page for the "Featured" sidebar slot.
 *
 * Replaces the bare external booking link with a real pitch page:
 * who the audience is, where the placement appears, and a booking CTA.
 * Directory stats are computed from build-time content; reach stats are
 * rendered at build time from public/data/site-stats.json (refreshed daily
 * by the site-stats workflow from Cloudflare Web Analytics and GitHub).
 */
import { getCollection } from 'astro:content';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { getResolvedComparisons } from '../lib/compare';
import { getAllTools, getCategoriesDetailed } from '../lib/tools';
import siteStatsJson from '../../public/data/site-stats.json';
import type { SiteStats } from '../lib/site-stats';

const siteStats = siteStatsJson as SiteStats;

const tools = getAllTools();
const toolCount = tools.length;
const categoryCount = getCategoriesDetailed().length;
const comparisonCount = getResolvedComparisons().length;
const postCount = (await getCollection('blog', ({ data }: { data: { draft?: boolean } }) => data.draft !== true)).length;
// The Featured slot renders inside the shared sidebar on every page:
// directory + tool + category + comparison + blog + utility pages.
const pageCount = toolCount + categoryCount + comparisonCount + postCount + 6;

const directoryStats = [
    { value: `${toolCount}+`, label: 'Curated tools' },
    { value: `${categoryCount}`, label: 'Category pages' },
    { value: `${comparisonCount}`, label: 'Comparison pages' },
    { value: `${postCount}`, label: 'Blog & news posts' },
    { value: `${pageCount}+`, label: 'Pages showing your placement' },
];

const reachStats = [
    { path: 'traffic.last30.visits', label: 'Visits, last 30 days' },
    { path: 'traffic.last30.pageViews', label: 'Page views, last 30 days' },
    { path: 'traffic.lifetime.visits', label: 'Visits, all time*' },
    { path: 'traffic.lifetime.pageViews', label: 'Page views, all time*' },
    { path: 'github.stars', label: 'GitHub stars' },
];

const compactNumber = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
const resolvePath = (value: unknown, path: string): unknown =>
    path.split('.').reduce<unknown>((current, key) => (current as Record<string, unknown> | null)?.[key], value);
const formatReachStat = (value: unknown) =>
    typeof value === 'number' && Number.isFinite(value)
        ? { text: compactNumber.format(value), title: value.toLocaleString('en') }
        : { text: '—', title: '' };
const fullDate = (value: string) => new Date(value).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' });
const sinceDate = siteStats.traffic ? new Date(siteStats.traffic.lifetime.since).toLocaleDateString('en', { month: 'short', year: 'numeric' }) : '';
const reachNote = siteStats.traffic
    ? `Cloudflare Web Analytics and GitHub, updated ${fullDate(siteStats.generatedAt)}. *All-time figures cover Cloudflare's available retention window (since ${sinceDate}).`
    : 'Traffic figures are shared on request.';

const dashboardData = {
    coverage: siteStats.detail?.coverage ?? null,
    daily: siteStats.detail?.daily ?? [],
    breakdowns: siteStats.detail?.breakdowns ?? {},
    history: siteStats.history ?? [],
};
const hasTrafficDetail = dashboardData.coverage !== null || dashboardData.daily.length > 0;
const hasStarHistory = dashboardData.history.length > 1;
const dashboardJson = JSON.stringify(dashboardData).replace(/</g, '\\u003c');
const rangeOptions = [
    { value: '7', label: '7d' },
    { value: '30', label: '30d' },
    { value: '90', label: '90d' },
];
const metricOptions = [
    { value: 'visits', label: 'Visits' },
    { value: 'pageViews', label: 'Page views' },
];
const breakdownOptions = [
    { value: 'pages', label: 'Top pages' },
    { value: 'referrers', label: 'Referrers' },
    { value: 'countries', label: 'Countries' },
    { value: 'devices', label: 'Devices' },
];
const toggleClass = 'px-3 py-1.5 font-mono text-[12px] text-ink-muted transition-colors hover:text-ink aria-pressed:bg-white/10 aria-pressed:text-ink';

const pricingTiers = [
    {
        name: 'Founding sponsor',
        price: '$149',
        period: '/ month',
        note: 'First 3 sponsors only. Rate locked for 6 months.',
        highlight: true,
    },
    {
        name: 'Monthly',
        price: '$199',
        period: '/ month',
        note: 'Rolling, cancel anytime.',
        highlight: false,
    },
    {
        name: 'Quarterly',
        price: '$499',
        period: '/ 3 months',
        note: 'Paid upfront. Save $98 vs monthly.',
        highlight: false,
    },
];

const pricingIncludes = [
    'Featured slot in the sidebar of every page, site-wide',
    'Mention in every daily Today in AI newsletter issue',
    'One copy change per month, no extra charge',
    'Reach report at the end of the term',
];

const faqs = [
    {
        q: 'Who visits ai.dosa.dev?',
        a: 'Software developers, engineering leads, and founders actively evaluating AI coding tools - AI IDEs, CLI agents, autonomous agents, and developer utilities. Visitors arrive with high intent: they are comparing options and choosing their stack, not casual browsing.',
    },
    {
        q: 'Where does my placement appear?',
        a: `The "Featured" slot lives in the sidebar that renders on every page of the site - the directory homepage, all ${toolCount} tool detail pages, and all ${categoryCount} category pages. One booking, site-wide presence.`,
    },
    {
        q: 'Can I get traffic stats before booking?',
        a: 'Yes - the Reach numbers above are refreshed daily from Cloudflare Web Analytics and GitHub, not hand-typed. Ask when you book if you want a per-page or per-category breakdown.',
    },
    {
        q: 'How is pricing set?',
        a: 'Flat rate, not auction. Prices are pegged to the Reach numbers above and will move as the audience grows - booking early locks your rate for the term.',
    },
    {
        q: 'What formats are supported?',
        a: 'The Featured slot is a short text placement: a headline, one sentence of copy, and a link. Keep it useful and specific - this audience responds to tools, not slogans.',
    },
];
---

<DashboardLayout
    title="Advertise | ai.dosa.dev"
    description={`Reach developers actively choosing their AI coding stack. One "Featured" placement appears across ai.dosa.dev - the directory, ${toolCount} tool pages, and ${categoryCount} category pages.`}
    canonical="https://ai.dosa.dev/advertise"
>
    <div class="max-w-[1400px] mx-auto w-full flex flex-col grow shrink-0 p-6 md:p-8">
        <div class="max-w-2xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-muted mb-3">Sponsorship</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-ink mb-4 leading-tight">
                Put your AI tool in front of developers choosing their stack.
            </h1>
            <p class="text-[15px] text-ink-secondary leading-relaxed mb-10">
                ai.dosa.dev is a hand-curated directory of AI coding tools. Every visitor is comparing
                options right now - the exact moment your tool should be on the page.
            </p>

            <!-- Stats -->
            <div class="mb-8">
                <div class="font-mono text-[11px] uppercase text-ink-muted mb-3 tracking-widest">Directory</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {directoryStats.map(stat => (
                        <div class="border border-border bg-white/[0.02] rounded-md px-5 py-4">
                            <div class="text-2xl font-semibold text-ink font-mono">{stat.value}</div>
                            <div class="text-[13px] text-ink-muted mt-1">{stat.label}</div>
                        </div>
                    ))}
                </div>
            </div>

            <div class="mb-10">
                <div class="font-mono text-[11px] uppercase text-ink-muted mb-3 tracking-widest">Reach</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {reachStats.map(stat => {
                        const display = formatReachStat(resolvePath(siteStats, stat.path));
                        return (
                            <div class="border border-border bg-white/[0.02] rounded-md px-5 py-4">
                                <div class="text-2xl font-semibold text-ink font-mono" title={display.title || undefined}>{display.text}</div>
                                <div class="text-[13px] text-ink-muted mt-1">{stat.label}</div>
                            </div>
                        );
                    })}
                </div>
                <p class="text-[12px] text-ink-disabled mt-2">
                    {reachNote}
                </p>
            </div>

            {(hasTrafficDetail || hasStarHistory) && (
                <section id="reach-dashboard" class="mb-10" aria-labelledby="reach-dashboard-title">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                        <h2 id="reach-dashboard-title" class="font-mono text-[11px] uppercase text-ink-muted tracking-widest">Reach dashboard</h2>
                        <div class="flex flex-wrap gap-2">
                            <div role="group" aria-label="Date range" class="inline-flex divide-x divide-border border border-border rounded-md overflow-hidden">
                                {rangeOptions.map(option => (
                                    <button type="button" data-range={option.value} aria-pressed={option.value === '30' ? 'true' : 'false'} class={toggleClass}>{option.label}</button>
                                ))}
                            </div>
                            {hasTrafficDetail && (
                                <div role="group" aria-label="Metric" class="inline-flex divide-x divide-border border border-border rounded-md overflow-hidden">
                                    {metricOptions.map(option => (
                                        <button type="button" data-metric={option.value} aria-pressed={option.value === 'visits' ? 'true' : 'false'} class={toggleClass}>{option.label}</button>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>

                    {hasTrafficDetail && (
                        <>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
                                <div class="border border-border bg-white/[0.02] rounded-md px-5 py-4">
                                    <div class="text-2xl font-semibold text-ink font-mono" data-kpi-total>—</div>
                                    <div class="text-[13px] text-ink-muted mt-1" data-kpi-total-label>Visits, last 30 days</div>
                                </div>
                                <div class="border border-border bg-white/[0.02] rounded-md px-5 py-4">
                                    <div class="text-2xl font-semibold text-ink font-mono" data-kpi-average>—</div>
                                    <div class="text-[13px] text-ink-muted mt-1">Daily average</div>
                                </div>
                                <div class="border border-border bg-white/[0.02] rounded-md px-5 py-4">
                                    <div class="text-2xl font-semibold text-ink font-mono" data-kpi-change>—</div>
                                    <div class="text-[13px] text-ink-muted mt-1" data-kpi-change-label>vs previous 30 days</div>
                                </div>
                            </div>

                            <div class="border border-border bg-white/[0.02] rounded-md px-4 pt-3 pb-2 mb-3">
                                <div class="font-mono text-[11px] text-ink-disabled mb-2" data-chart-range></div>
                                <div class="relative">
                                    <svg data-traffic-chart viewBox="0 0 640 180" preserveAspectRatio="none" class="block w-full h-44 touch-none" role="img" aria-label="Daily traffic trend">
                                        <path data-area fill="var(--color-gold)" fill-opacity="0.12" />
                                        <path data-line fill="none" stroke="var(--color-gold)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
                                        <circle data-marker r="4" fill="var(--color-gold)" visibility="hidden" />
                                    </svg>
                                    <div data-traffic-tooltip hidden class="pointer-events-none absolute -top-1 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded-sm border border-border bg-panel px-2 py-1 font-mono text-[11px] text-ink"></div>
                                </div>
                            </div>

                            <div class="border border-border bg-white/[0.02] rounded-md px-2 py-3 mb-3">
                                <div role="group" aria-label="Breakdown" class="flex flex-wrap gap-1 px-1 mb-2">
                                    {breakdownOptions.map(option => (
                                        <button type="button" data-breakdown={option.value} aria-pressed={option.value === 'pages' ? 'true' : 'false'} class={`${toggleClass} rounded-md`}>{option.label}</button>
                                    ))}
                                </div>
                                <ol data-breakdown-list class="flex flex-col gap-1"></ol>
                            </div>
                        </>
                    )}

                    {hasStarHistory && (
                        <div class="border border-border bg-white/[0.02] rounded-md px-4 pt-3 pb-2">
                            <div class="flex items-baseline justify-between gap-3 mb-2">
                                <div class="text-[13px] text-ink-muted">GitHub stars <span class="font-mono text-ink" data-stars-total>—</span></div>
                                <div class="font-mono text-[11px] text-ink-disabled" data-stars-delta></div>
                            </div>
                            <div class="relative">
                                <svg data-stars-chart viewBox="0 0 640 180" preserveAspectRatio="none" class="block w-full h-24 touch-none" role="img" aria-label="GitHub stars trend">
                                    <path data-area fill="var(--color-ink)" fill-opacity="0.06" />
                                    <path data-line fill="none" stroke="var(--color-ink-secondary)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
                                    <circle data-marker r="4" fill="var(--color-ink)" visibility="hidden" />
                                </svg>
                                <div data-stars-tooltip hidden class="pointer-events-none absolute -top-1 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded-sm border border-border bg-panel px-2 py-1 font-mono text-[11px] text-ink"></div>
                            </div>
                        </div>
                    )}

                    <p class="text-[12px] text-ink-disabled mt-2">
                        Daily figures are complete UTC days from Cloudflare Web Analytics; GitHub stars are a daily snapshot.
                    </p>
                    <script id="reach-dashboard-data" type="application/json" set:html={dashboardJson}></script>
                    <script src="/dist/advertise-dashboard.js" type="module" defer></script>
                </section>
            )}

            <!-- Placement preview -->
            <div class="mb-10">
                <div class="font-mono text-[11px] uppercase text-ink-muted mb-3 tracking-widest">The placement</div>
                <div class="p-4 border border-dashed border-border rounded-md bg-white/[0.01] max-w-xs">
                    <div class="font-mono text-[11px] uppercase text-ink-muted mb-1.5 tracking-wide">Featured</div>
                    <div class="text-[13px] text-ink-secondary leading-relaxed">
                        Your headline and one sentence, here.
                        <br />
                        <span class="gradient-link inline-block mt-1.5 font-mono">Your link &rarr;</span>
                    </div>
                </div>
                <p class="text-[13px] text-ink-muted mt-3 leading-relaxed">
                    Rendered in the sidebar of every page - directory, tool pages, and category pages - and
                    repeated in each daily Today in AI newsletter issue.
                </p>
            </div>

            <!-- Pricing -->
            <div class="mb-10">
                <div class="font-mono text-[11px] uppercase text-ink-muted mb-3 tracking-widest">Pricing</div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {pricingTiers.map(tier => (
                        <div class:list={[
                            'relative border rounded-md px-5 py-4 flex flex-col',
                            tier.highlight ? 'border-gold/60 bg-gold/[0.06]' : 'border-border bg-white/[0.02]',
                        ]}>
                            {tier.highlight && (
                                <span class="absolute -top-2 left-4 font-mono text-[10px] uppercase tracking-widest bg-gold text-black px-1.5 py-0.5 rounded-sm">Limited</span>
                            )}
                            <div class="text-[13px] text-ink-secondary font-medium">{tier.name}</div>
                            <div class="mt-2 flex items-baseline gap-1">
                                <span class="text-2xl font-semibold text-ink font-mono">{tier.price}</span>
                                <span class="text-[12px] text-ink-muted font-mono">{tier.period}</span>
                            </div>
                            <div class="text-[12px] text-ink-muted mt-2 leading-relaxed">{tier.note}</div>
                        </div>
                    ))}
                </div>
                <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5">
                    {pricingIncludes.map(item => (
                        <li class="flex items-start gap-2 text-[13px] text-ink-secondary leading-relaxed">
                            <span aria-hidden="true" class="mt-[7px] h-1.5 w-1.5 rounded-full bg-gold shrink-0"></span>
                            {item}
                        </li>
                    ))}
                </ul>
                <p class="text-[12px] text-ink-disabled mt-3">All plans include the same placement. Prices in USD.</p>
            </div>

            <!-- CTA -->
            <div class="flex flex-col sm:flex-row gap-3 mb-12">
                <a href="https://book.qainsights.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center py-2.5 px-6 bg-white text-black text-sm font-semibold rounded-md transition-all duration-200 hover:bg-gray-200 hover:-translate-y-px">
                    Book this space
                </a>
                <a href="https://github.com/QAInsights/awesome-ai-tools" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center py-2.5 px-6 bg-white/5 text-ink text-sm font-medium border border-border rounded-md transition-all duration-200 hover:bg-white/10 hover:-translate-y-px">
                    See the project on GitHub
                </a>
            </div>

            <!-- FAQ -->
            <div class="font-mono text-[11px] uppercase text-ink-muted mb-4 tracking-widest">Questions</div>
            <div class="flex flex-col gap-4">
                {faqs.map(f => (
                    <details class="border border-border bg-white/[0.02] rounded-md group">
                        <summary class="cursor-pointer px-5 py-4 text-[15px] font-medium text-ink list-none flex items-center justify-between gap-3 hover:bg-white/[0.03] transition-colors rounded-md">
                            {f.q}
                            <svg class="w-4 h-4 text-ink-disabled shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <p class="px-5 pb-4 pt-1 text-[14px] text-ink-secondary leading-relaxed">{f.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </div>
</DashboardLayout>
