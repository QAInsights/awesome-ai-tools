---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
    title="Settings | ai.dosa.dev"
    description="Account settings for ai.dosa.dev - manage your preferences and profile."
    canonical="https://ai.dosa.dev/settings"
    robots="noindex, nofollow"
    activeNav="settings"
>
    <div class="max-w-[1400px] mx-auto w-full flex flex-col grow shrink-0 p-8">
        <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold mb-6 flex items-center gap-3">
                <svg class="w-6 h-6 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                Settings
            </h2>
            <div id="settingsLoading" class="border border-[#222] bg-white/[0.02] rounded-xl p-6 text-[#a3a3a3]">
                Loading your settings…
            </div>
            <div id="settingsSignedOut" class="hidden border border-[#222] bg-white/[0.02] rounded-xl p-7">
                <h2 class="text-lg font-semibold mb-2">Sign in to manage notifications</h2>
                <p class="text-[#a3a3a3] text-[14px] mb-5">Notification settings are private and sync across your devices.</p>
                <a href="/?signin=1" data-auth-trigger="settings" class="inline-flex items-center py-2.5 px-4 bg-white text-black text-sm font-semibold rounded-md hover:bg-gray-200 transition-colors">Sign in</a>
            </div>
            <div id="settingsError" class="hidden border border-red-400/20 bg-red-400/[0.06] rounded-xl p-6 text-red-200">
                Settings could not be loaded. Please refresh and try again.
            </div>
            <section id="notificationsCard" class="hidden border border-[#222] bg-white/[0.02] rounded-xl p-6">
                <div class="flex items-start justify-between gap-6">
                    <div>
                        <h2 class="text-lg font-semibold">Notifications</h2>
                        <p class="text-[#a3a3a3] text-[14px] mt-2">Email updates for tools you follow</p>
                    </div>
                    <button
                        id="notificationEmailToggle"
                        type="button"
                        role="switch"
                        aria-checked="false"
                        aria-label="Email updates for tools you follow"
                        class="relative w-11 h-6 shrink-0 rounded-full bg-[#333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#c9aa6e]"
                    >
                        <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white transition-transform"></span>
                    </button>
                </div>
                <p class="text-[#737373] text-[13px] mt-5">Email: <span id="notificationEmail" class="text-[#a3a3a3]">—</span></p>
                <p class="text-[#737373] text-[13px] mt-2">Digest is sent every two weeks when followed tools change.</p>
                <p id="notificationEmailWarning" class="hidden text-amber-200 text-[13px] mt-4">Your account does not have a verified email address, so digests cannot be sent yet.</p>
                <div class="h-px bg-border my-5"></div>
                <div class="flex items-start justify-between gap-6">
                    <div>
                        <h2 class="text-lg font-semibold">Daily Today in AI brief</h2>
                        <p class="text-[#a3a3a3] text-[14px] mt-2">One email each morning with the day's AI news, only when a brief was published</p>
                    </div>
                    <button
                        id="notificationNewsToggle"
                        type="button"
                        role="switch"
                        aria-checked="false"
                        aria-label="Daily Today in AI brief"
                        class="relative w-11 h-6 shrink-0 rounded-full bg-[#333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#c9aa6e]"
                    >
                        <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white transition-transform"></span>
                    </button>
                </div>
            </section>
            <section id="publicProfileCard" class="hidden border border-[#222] bg-white/[0.02] rounded-xl p-6 mt-5">
                <div>
                    <h2 class="text-lg font-semibold">Public profile</h2>
                    <p class="text-[#a3a3a3] text-[14px] mt-2">Choose the username used for your public tool stacks. Previous username links redirect to your current profile.</p>
                </div>
                <div id="publicProfileSignedOut" class="hidden mt-5">
                    <p class="text-[13px] text-[#a3a3a3] mb-4">Sign in to view and change your public username.</p>
                    <a href="/?signin=1" data-auth-trigger="favorite_heart" class="inline-flex items-center py-2 px-3 bg-white text-black text-[13px] font-semibold rounded-md hover:bg-gray-200 transition-colors">Sign in</a>
                </div>
                <form id="publicProfileForm" class="hidden mt-5">
                    <label for="publicUsername" class="block text-[12px] text-[#a3a3a3] mb-2">Username</label>
                    <div class="flex flex-wrap gap-2">
                        <input id="publicUsername" name="username" autocomplete="username" minlength="3" maxlength="30" required class="min-w-0 flex-1 rounded-lg border border-[#303030] bg-black/30 px-3 py-2.5 text-sm text-white focus:border-[#c9aa6e] focus:outline-none" />
                        <button id="savePublicUsername" type="submit" class="py-2.5 px-4 bg-white text-black text-sm font-semibold rounded-md hover:bg-gray-200 disabled:opacity-50">Save username</button>
                    </div>
                    <p id="publicProfileStatus" role="status" class="text-[12px] text-[#a3a3a3] mt-3"></p>
                    <a id="publicProfileLink" class="hidden inline-block mt-2 text-[13px] text-[#c9aa6e] hover:text-white" href="#">View public profile →</a>
                </form>
            </section>
        </div>
    </div>
    <script src="/dist/settings-page.js" type="module" defer></script>
</DashboardLayout>
