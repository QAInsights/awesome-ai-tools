---
/**
 * Main index page - the tool directory.
 *
 * Build-time: Fetches all tool data (README + enriched JSON).
 * Runtime:    Search, filter, sort, and voting are hydrated via client script.
 *
 * Key differences from the old index.html:
 *   - Tool cards are NOT pre-rendered in HTML - the grid is populated by
 *     client-side JS (same as before) reading a build-time injected JSON blob.
 *   - Sidebar is a reusable component, not inline HTML.
 *   - No shell.js needed - layout is static.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ToolRow from '../components/ToolRow.astro';
import { formatDate, getAllTools, getLatestUpdate } from '../lib/tools';

const tools = getAllTools();
const categoryCount = new Set(tools.map(t => t.category)).size;

// Honest freshness signal: the latest lastUpdated stamp from the enrichment
// pipeline. Falls back to the build date only when no tool is dated.
const latestUpdate = getLatestUpdate(tools);
const latestUpdateLabel = latestUpdate ? formatDate(latestUpdate) : '';

// Build structured data JSON-LD
const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "https://ai.dosa.dev/#website",
            "url": "https://ai.dosa.dev",
            "name": "ai.dosa.dev - Awesome AI Tools",
            "description": "A curated directory of AI-powered coding tools, autonomous agents, and developer utilities.",
            "inLanguage": "en",
            "potentialAction": {
                "@type": "SearchAction",
                "target": { "@type": "EntryPoint", "urlTemplate": "https://ai.dosa.dev/?q={search_term_string}" },
                "query-input": "required name=search_term_string"
            }
        },
        {
            "@type": "CollectionPage",
            "@id": "https://ai.dosa.dev/#collection",
            "url": "https://ai.dosa.dev",
            "name": "Awesome AI Tools Directory",
            "description": `${tools.length}+ manually curated AI-powered coding tools across 12 categories.`,
            "isPartOf": { "@id": "https://ai.dosa.dev/#website" },
            "publisher": { "@id": "https://ai.dosa.dev/#organization" },
            "about": { "@type": "Thing", "name": "AI-powered developer tools" },
            "keywords": "AI IDE, AI coding assistant, terminal agent, autonomous agent, vibe coding, AI code review",
            "inLanguage": "en",
            "dateModified": latestUpdate ?? new Date().toISOString().slice(0, 10),
            "image": { "@type": "ImageObject", "url": "https://ai.dosa.dev/images/og-image.png", "width": 1200, "height": 630 }
        },
        {
            "@type": "Organization",
            "@id": "https://ai.dosa.dev/#organization",
            "name": "dosa.dev",
            "url": "https://ai.dosa.dev",
            "logo": { "@type": "ImageObject", "url": "https://ai.dosa.dev/images/icons/favicon-96x96.png", "width": 96, "height": 96 }
        },
        {
            "@type": "ItemList",
            "@id": "https://ai.dosa.dev/#toollist",
            "name": "Curated AI Coding Tools",
            "numberOfItems": tools.length,
            "itemListElement": tools.map((t, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "name": t.name,
                "url": `https://ai.dosa.dev/tools/${t.slug}`
            }))
        }
    ]
});

// Serialize all tool data for client-side hydration
// The client JS reads this to power search/filter/sort/voting
const toolsJson = JSON.stringify(tools);
---

<BaseLayout
    title={`Awesome AI Coding Tools - ${tools.length}+ Curated AI IDEs, Agents & Assistants | ai.dosa.dev`}
    description={`${tools.length}+ manually curated AI coding tools across 12 categories: AI IDEs, CLI agents, autonomous agents, code review, and more. Compare features, pricing, and verdicts. Hosted by dosa.dev.`}
    keywords="AI tools, AI coding tools, best AI IDE, AI coding assistant, terminal AI agent, autonomous coding agent, AI code review, vibe coding tools, Cursor alternatives, curated list, dosa.dev"
    canonical="https://ai.dosa.dev/"
    jsonLd={jsonLd}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="index" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative">
            <div class="max-w-[1400px] mx-auto w-full flex flex-col flex-1 min-h-0">
                <SiteHeader variant="index">
                    <button id="filterAccordionBtn" class="refine-btn flex h-[52px] items-center gap-2.5 px-4 md:px-5 rounded-2xl text-sm font-medium transition-all active:scale-[0.98] shrink-0">
                        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        <span class="hidden sm:inline">Scope</span>
                        <span id="activeFilterBadge" class="hidden font-mono text-[10px] bg-white text-black px-1.5 py-0.5 rounded-full"></span>
                    </button>
                    <!-- Filter Mega Menu Overlay -->
                    <div id="filterAccordion" class="hidden" slot="overlay">
                        <div class="px-8 py-8 max-w-[1400px] mx-auto">
                            <div class="font-mono text-[11px] uppercase text-[#525252] mb-6 tracking-[0.2em] px-1">Browse by Category</div>
                            <div id="categoryFilters">
                                <!-- Cards injected via JS -->
                            </div>
                        </div>
                    </div>
                </SiteHeader>
                <!-- Hero: one-line orientation for first-time visitors -->
                <div class="px-4 md:px-8 pt-6 md:pt-8 pb-2 shrink-0">
                    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#737373] mb-2.5 flex items-center gap-2">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d6b77a]"></span>
                        {tools.length} tools &middot; {categoryCount} categories &middot; curated by hand{latestUpdateLabel && <>&nbsp;&middot; updated <time datetime={latestUpdate!}>{latestUpdateLabel}</time></>}
                    </p>
                    <p class="text-[22px] md:text-[28px] font-semibold text-white leading-tight tracking-tight m-0">
                        Find your <span class="text-[#e2c48a]">AI coding stack</span>
                    </p>
                </div>

                <!-- Table Header -->
                <div class="table-header hidden md:flex items-center px-8 py-5 border-b border-[#222] font-mono text-[14px] text-[#a3a3a3] uppercase tracking-widest bg-black shrink-0 transition-all duration-300 sticky top-[89px] z-10 overflow-y-auto" id="tableHeader">
                    <div class="reg-col-name text-sm transition-all duration-300 cursor-pointer hover:text-white select-none flex items-center gap-2" data-sort="name" id="thName">Name <span class="sort-icon opacity-50">↕</span></div>
                    <div class="reg-col-company text-sm cursor-pointer hover:text-white select-none flex items-center gap-2" data-sort="company">Company <span class="sort-icon opacity-50">↕</span></div>
                    <div class="reg-col-desc text-sm cursor-pointer hover:text-white select-none" style="pointer-events: none;">Description</div>
                    <div class="reg-col-category hidden lg:flex text-sm cursor-pointer hover:text-white select-none items-center justify-center gap-2" data-sort="category">Category <span class="sort-icon opacity-50">↕</span></div>
                    <div class="reg-col-zap text-sm cursor-pointer hover:text-white select-none flex items-center justify-center gap-2" data-sort="votes">⚡ Zap <span class="sort-icon opacity-50">↕</span></div>
                </div>

                <!-- Tool Grid - pre-rendered at build time (SSR); JS hydrates compare/zap
                     state in place and only re-renders on search/filter/sort interaction -->
                <div class="registry px-4 pb-4 pt-2 md:px-8 md:pb-8 md:pt-4 grow overflow-y-auto" id="toolGrid" data-registry data-ssr="true">
                    {tools.map((t, i) => <ToolRow tool={t} index={i} />)}
                </div>
            </div>
        </main>

    </div>

    <!-- Compare Floating Bar -->
    <div id="compareFloatingBar" class="fixed bottom-0 left-0 right-0 z-50 border-t border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03))] backdrop-blur-lg px-4 py-3 sm:px-6 shadow-[0_-20px_60px_rgba(0,0,0,0.35)]" style="transition: translate 0.3s ease; translate: 0 100%;">
        <div class="mx-auto flex w-full max-w-[1400px] flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-2">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center gap-2 rounded-full border border-[#7d6339] bg-[#2a1f12] px-2.5 py-1 text-[#e2c48a]">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <circle cx="10" cy="10" r="7" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.3"></circle>
                            <path d="M6.4 10.7C7.8 11.2 9.5 10.6 11.3 7.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                            <path d="M10.9 7.2L12.5 6.6L12.1 8.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        <span class="hidden sm:inline text-[11px] font-mono uppercase tracking-[0.18em]">Compare</span>
                    </span>
                    <span id="compareCountText" class="text-[#fff7e8] text-sm font-semibold">Select tools to compare</span>
                </div>
                <p id="compareHelperText" class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[#d9c7a3]">
                    <span>Pick up to 3 tools. Compare unlocks when you select at least 2.</span>
                    <span class="inline-flex items-center gap-1.5 text-[#c9aa6e]">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <ellipse cx="10" cy="11.8" rx="6.6" ry="4.1" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.2"></ellipse>
                            <circle cx="7.4" cy="8.8" r="2.1" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="0.8"></circle>
                            <circle cx="12.6" cy="8.2" r="2.4" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="0.8"></circle>
                        </svg>
                        <span class="text-[12px]">idli-sized picks</span>
                    </span>
                </p>
                <div id="compareThumbnails" class="flex flex-wrap items-center gap-2"></div>
            </div>
            <div class="flex items-center gap-3 self-start sm:self-auto">
                <button id="clearCompareBtn" class="text-[#dbc69c] hover:text-white text-sm px-3 py-1.5 transition-colors">Clear</button>
                <button id="compareBtn" class="cursor-pointer rounded-full border border-[#f0d08f] bg-[linear-gradient(180deg,#f1d99f,#d6b77a)] px-4 py-2 text-sm font-semibold text-[#2d1d0b] transition-all duration-300 hover:-translate-y-px hover:border-[#f4ddb0] hover:bg-[linear-gradient(180deg,#f5dfae,#e0c184)] disabled:cursor-not-allowed disabled:opacity-50">Compare</button>
            </div>
        </div>
    </div>

    <!-- Build-time injected tool data for client-side hydration -->
    <script id="tools-data" type="application/json" set:html={toolsJson} />

    <!-- Client-side application scripts -->
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
