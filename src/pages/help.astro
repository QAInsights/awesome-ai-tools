---
import DashboardLayout from '../layouts/DashboardLayout.astro';

const faqs = [
    {
        q: 'What is ai.dosa.dev?',
        a: 'ai.dosa.dev is a manually curated directory of 140+ AI-powered coding tools - AI IDEs, CLI agents, autonomous agents, code review tools, and more - organized across 12 categories. Each tool has a detail page with pricing, key features, and a verdict.',
    },
    {
        q: 'How do I submit a tool to the directory?',
        a: 'Use the Tool Submission form on GitHub (linked from the "Submit a Tool" button). Submissions run through an automated pipeline that validates and enriches the entry. Please do not open pull requests for new tools.',
    },
    {
        q: 'What is "Zap"?',
        a: 'Zap is the voting feature. Sign in with GitHub or Google, then Zap a tool to support it and contribute to its public popularity count.',
    },
    {
        q: 'What are Favorites?',
        a: 'Favorites are private bookmarks. Save tools you want to revisit, then open your Favorites page to see them from any signed-in device. Favoriting does not affect Zap votes or rankings.',
    },
    {
        q: 'Do I need an account to use the directory?',
        a: 'No. Browsing, searching, filtering, comparing tools, and both utilities (Token Counter, Hallucination Scorer) work without an account. Signing in unlocks private Favorites and Zap voting.',
    },
    {
        q: 'How do I get the Featured on ai.dosa.dev badge?',
        a: 'If your tool is listed, open ai.dosa.dev/badge, pick your tool, and copy the Markdown or HTML snippet into your README or website. The badge links back to your tool\'s page.',
    },
    {
        q: 'How does the Token Counter work?',
        a: 'Paste any text and get instant token counts and cost estimates across major models (GPT, Claude, Gemini, Llama, and more via models.dev). It runs 100% client-side - your text never leaves your browser.',
    },
    {
        q: 'How does the Hallucination Risk Scorer work?',
        a: 'It applies heuristic checks to your prompt - vague context, forced output formats, fact density, and similar patterns - and returns a risk score with specific flags. It also runs entirely in your browser.',
    },
    {
        q: 'What analytics data is collected?',
        a: 'We use Cloudflare analytics to measure aggregate site usage and first-party product events such as sign-in attempts, favorites, Zap votes, comparisons, and outbound tool clicks. Event data uses a random browser identifier, never a fingerprint, and does not include email addresses or full destination URLs. Global Privacy Control and Do Not Track requests omit the browser identifier.',
    },
    {
        q: 'Is the tool information accurate?',
        a: 'Tool details are manually curated and partially AI-enriched. Pricing, features, and availability change fast - always verify details on the vendor\'s official website before making decisions.',
    },
    {
        q: 'How do I compare tools side by side?',
        a: 'Select up to 3 tools using the compare control on the directory page, then hit Compare to see features, pricing, and verdicts side by side. Comparisons can be shared or exported as an image.',
    },
    {
        q: 'How can I report an error or outdated entry?',
        a: 'Open an issue on the GitHub repository (github.com/QAInsights/awesome-ai-tools) describing the tool and what needs correcting.',
    },
];

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
});
---

<DashboardLayout
    title="Help & FAQ | ai.dosa.dev"
    description="Help documentation and FAQs for ai.dosa.dev - how to submit tools, vote with Zap, save Favorites, and use the free token counter and hallucination scorer."
    canonical="https://ai.dosa.dev/help"
    jsonLd={jsonLd}
    activeNav="help"
>
    <div class="max-w-[1400px] mx-auto w-full flex flex-col flex-1 min-h-0 p-8">
        <div class="max-w-2xl">
            <h1 class="text-2xl font-semibold mb-6 flex items-center gap-3">
                <svg class="w-6 h-6 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                Help &amp; FAQ
            </h1>
            <div class="flex flex-col gap-4">
                {faqs.map(f => (
                    <details class="border border-[#222] bg-white/[0.02] rounded-md group">
                        <summary class="cursor-pointer px-5 py-4 text-[15px] font-medium text-white list-none flex items-center justify-between gap-3 hover:bg-white/[0.03] transition-colors rounded-md">
                            {f.q}
                            <svg class="w-4 h-4 text-[#525252] shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <p class="px-5 pb-4 pt-1 text-[14px] text-[#a3a3a3] leading-relaxed">{f.a}</p>
                    </details>
                ))}
            </div>
            <section class="mt-10">
                <h2 class="text-xs font-mono uppercase tracking-widest text-[#525252] mb-4">Feeds</h2>
                <div class="flex flex-col gap-3 text-[14px] text-[#a3a3a3]">
                    <p><a href="/news/rss.xml" class="font-mono text-[#737373] hover:text-white">/news/rss.xml</a> - Today in AI briefs in RSS format.</p>
                    <p><a href="/tools/rss.xml" class="font-mono text-[#737373] hover:text-white">/tools/rss.xml</a> - The directory tools in RSS format, most recently updated first.</p>
                    <p><a href="/rss.xml" class="font-mono text-[#737373] hover:text-white">/rss.xml</a> - All blog posts in RSS format.</p>
                </div>
            </section>
        </div>
    </div>
</DashboardLayout>
