---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import WorkflowGuideCta from '../../components/WorkflowGuideCta.astro';
import { ORGANIZATION } from '../../lib/site';
import { getResolvedWorkflowGuides, type ResolvedWorkflowGuide } from '../../lib/workflow-guides';

export function getStaticPaths() {
    return getResolvedWorkflowGuides().map(guide => ({
        params: { slug: guide.slug },
        props: { guide },
    }));
}

interface Props {
    guide: ResolvedWorkflowGuide;
}

const { guide } = Astro.props;
const hubUrl = new URL('/guides', Astro.site).href;
const pageUrl = `${hubUrl}/${guide.slug}`;
const jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Article',
            headline: guide.title,
            description: guide.description,
            mainEntityOfPage: pageUrl,
            publisher: ORGANIZATION,
        },
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
                { '@type': 'ListItem', position: 2, name: 'Workflow guides', item: hubUrl },
                { '@type': 'ListItem', position: 3, name: guide.title, item: pageUrl },
            ],
        },
    ],
});
---

<BaseLayout title={`${guide.title} | ai.dosa.dev`} description={guide.description} canonical={pageUrl} ogType="article" jsonLd={jsonLd}>
    <SiteHeader variant="page" title="Workflow guides" />
    <main class="mx-auto max-w-5xl px-5 pt-8 pb-28 sm:px-8 md:pt-12">
        <nav aria-label="Breadcrumb" class="flex flex-wrap gap-x-2 text-sm text-ink-secondary">
            <a href="/" class="hover:text-white">Home</a><span aria-hidden="true">/</span>
            <a href="/guides" class="hover:text-white">Workflow guides</a><span aria-hidden="true">/</span>
            <span aria-current="page">{guide.title}</span>
        </nav>
        <article>
            <header class="mt-8 border-b border-border pb-8">
                <p class="font-mono text-xs tracking-widest text-gold-soft uppercase">Workflow guide · {guide.tools.length} tools</p>
                <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-balance md:text-6xl">{guide.title}</h1>
                <p class="mt-4 max-w-3xl text-lg text-ink-secondary">{guide.intro}</p>
            </header>
            <section aria-labelledby="compare-tools" class="mt-8">
                <h2 id="compare-tools" class="text-2xl font-semibold tracking-tight">Compare the tools</h2>
                <div class="mt-4 overflow-x-auto rounded-xl border border-border" role="region" aria-labelledby="compare-tools" tabindex="0">
                    <table aria-labelledby="compare-tools" class="w-full min-w-[34rem] border-collapse text-left text-sm">
                        <thead class="bg-panel">
                            <tr>
                                <th scope="col" class="px-4 py-3">Tool</th>
                                <th scope="col" class="px-4 py-3">Best for</th>
                                <th scope="col" class="px-4 py-3">Tradeoff</th>
                            </tr>
                        </thead>
                        <tbody>
                            {guide.tools.map(tool => (
                                <tr class="border-t border-border align-top">
                                    <th scope="row" class="w-1/5 px-4 py-3 font-semibold"><a href={tool.href} class="text-gold-soft hover:underline">{tool.name}</a></th>
                                    <td class="w-2/5 px-4 py-3 text-ink-secondary">{tool.bestFor}</td>
                                    <td class="w-2/5 px-4 py-3 text-ink-secondary">{tool.tradeoff}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
            <section aria-labelledby="workflow-steps" class="mt-10">
                <h2 id="workflow-steps" class="text-2xl font-semibold tracking-tight">A practical workflow</h2>
                <ol class="mt-4 max-w-3xl list-decimal space-y-3 pl-6 text-ink-secondary marker:font-semibold marker:text-gold-soft">
                    {guide.steps.map(step => <li class="pl-2">{step}</li>)}
                </ol>
            </section>
            <section aria-labelledby="tool-trials" class="my-10">
                <h2 id="tool-trials" class="text-2xl font-semibold tracking-tight">Try one on your project</h2>
                <ul class="mt-4 grid gap-4 md:grid-cols-3">
                    {guide.tools.map(tool => (
                        <li class="rounded-xl border border-border bg-panel p-5">
                            <h3 class="font-semibold"><a href={tool.href} class="text-gold-soft hover:underline">{tool.name}</a></h3>
                            <p class="mt-2 text-sm text-ink-secondary">{tool.tryIt}</p>
                        </li>
                    ))}
                </ul>
            </section>
        </article>
        <WorkflowGuideCta />
        <p class="mt-8"><a href="/guides" class="text-sm font-semibold text-gold-soft hover:underline">← All workflow guides</a></p>
    </main>
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
