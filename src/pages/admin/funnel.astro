---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { formatDelta, formatPointDelta, formatRate, loadFunnel, loadGrowth, parseFunnelRange, referrerGroup } from '../../lib/server/analytics-query';
import { getAdminUserIds, requireDatabase } from '../../lib/server/runtime-env';
import { getCookieSessionUser } from '../../lib/server/route-auth';

export const prerender = false;

const user = await getCookieSessionUser(Astro.cookies, requireDatabase());
if (!user || !getAdminUserIds().has(user.id)) {
    return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('Cache-Control', 'private, max-age=300');
const range = parseFunnelRange(Astro.url.searchParams.get('range'));
const rangeMs = { '24h': 86_400_000, '7d': 604_800_000, '30d': 2_592_000_000 }[range];
const cutoff = Date.now() - rangeMs;
const activeCutoff = Date.now() - 604_800_000;
const db = requireDatabase();

const analyticsPromise = loadFunnel(range);
const d1Promise = db.batch<{ count: number }>([
    db.prepare('SELECT COUNT(*) AS count FROM users'),
    db.prepare('SELECT COUNT(*) AS count FROM users WHERE created_at >= ?').bind(cutoff),
    db.prepare('SELECT COUNT(*) AS count FROM users WHERE last_seen_at >= ?').bind(activeCutoff),
]);
const [{ data: funnel, error: analyticsError }, { data: growth, error: growthError }, d1Results] = await Promise.all([analyticsPromise, loadGrowth(), d1Promise]);
const { shown, started, completed, providers: providerRows, triggers: triggerRows, outbound: outboundRows, badgeReferrals, adPrompt } = funnel;
const rate = (numerator: number, denominator: number) => denominator
    ? `${((numerator / denominator) * 100).toFixed(1)}%`
    : '—';
const totalUsers = d1Results[0]?.results?.[0]?.count ?? 0;
const newUsers = d1Results[1]?.results?.[0]?.count ?? 0;
const activeUsers = d1Results[2]?.results?.[0]?.count ?? 0;
const groupLabels = { search: 'Search', github: 'GitHub', social: 'Social', ai: 'AI assistants', direct: 'Direct', other: 'Other' } as const;
const deltaClass = (value: string) => value.startsWith('+') || value === 'new' ? 'text-emerald-300' : value.startsWith('-') ? 'text-rose-300' : 'text-[#737373]';
---

<DashboardLayout
    title="Funnel Analytics | ai.dosa.dev"
    description="Private signup funnel analytics."
    robots="noindex, nofollow"
    activeNav="admin"
>
    <div class="max-w-[1100px] mx-auto w-full p-5 md:p-8">
        <header class="flex flex-wrap items-end justify-between gap-4 mb-8">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#737373] mb-2">Private dashboard</p>
                <h1 class="text-2xl md:text-3xl font-semibold">Signup funnel</h1>
                <p class="text-[#737373] text-xs mt-2">Analytics Engine counts are sampling-corrected estimates.</p>
            </div>
            <nav class="flex gap-2" aria-label="Analytics range">
                {(['24h', '7d', '30d'] as const).map(value => (
                    <a href={`/admin/funnel?range=${value}`} class={`px-3 py-2 rounded-md border text-sm ${range === value ? 'border-white bg-white text-black' : 'border-[#333] text-[#a3a3a3] hover:text-white'}`}>{value}</a>
                ))}
            </nav>
        </header>

        {analyticsError && (
            <div class="border border-amber-400/20 bg-amber-400/[0.06] text-amber-200 rounded-lg p-4 mb-6">
                {analyticsError}
            </div>
        )}

        <section class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
            {[
                ['Total users', totalUsers],
                [`New users (${range})`, newUsers],
                ['Active users (7d)', activeUsers],
            ].map(([label, value]) => (
                <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                    <p class="text-[#737373] text-xs mb-2">{label}</p>
                    <p class="font-mono text-2xl text-white">{value}</p>
                </div>
            ))}
        </section>

        <section class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
            {[
                ['Modal shown', shown, '—'],
                ['Sign-in started', started, rate(started, shown)],
                ['Sign-in completed', completed, rate(completed, started)],
            ].map(([label, value, conversion]) => (
                <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                    <p class="text-[#737373] text-xs mb-2">{label}</p>
                    <div class="flex items-baseline justify-between gap-3">
                        <p class="font-mono text-2xl text-white">{value}</p>
                        <p class="font-mono text-sm text-[#c9aa6e]">{conversion}</p>
                    </div>
                </div>
            ))}
        </section>

        <h2 class="font-semibold mb-3">Ad-close sign-up prompt</h2>
        <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
            {[
                ['Ads closed', adPrompt.closed, '—'],
                ['Prompt shown', adPrompt.shown, rate(adPrompt.shown, adPrompt.closed)],
                ['Sign-in opened', adPrompt.opened, rate(adPrompt.opened, adPrompt.shown)],
                ['Sign-in completed', adPrompt.completed, rate(adPrompt.completed, adPrompt.shown)],
            ].map(([label, value, conversion]) => (
                <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                    <p class="text-[#737373] text-xs mb-2">{label}</p>
                    <div class="flex items-baseline justify-between gap-3">
                        <p class="font-mono text-2xl text-white">{value}</p>
                        <p class="font-mono text-sm text-[#c9aa6e]">{conversion}</p>
                    </div>
                </div>
            ))}
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <section class="border border-[#222] rounded-lg overflow-hidden">
                <h2 class="font-semibold px-5 py-4 border-b border-[#222]">Provider conversion</h2>
                <table class="w-full text-sm">
                    <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Provider</th><th>Started</th><th>Completed</th><th>Rate</th></tr></thead>
                    <tbody>{providerRows.map(row => <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3 capitalize">{row.provider}</td><td>{row.started}</td><td>{row.completed}</td><td>{rate(row.completed, row.started)}</td></tr>)}</tbody>
                </table>
            </section>

            <section class="border border-[#222] rounded-lg overflow-hidden">
                <h2 class="font-semibold px-5 py-4 border-b border-[#222]">Gate-to-signup by trigger</h2>
                <table class="w-full text-sm">
                    <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Trigger</th><th>Blocked</th><th>Completed</th></tr></thead>
                    <tbody>{triggerRows.map(row => <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3 font-mono">{row.trigger}</td><td>{row.blocked}</td><td>{row.completed}</td></tr>)}</tbody>
                </table>
            </section>
        </div>

        <section class="border border-[#222] rounded-lg overflow-hidden">
            <h2 class="font-semibold px-5 py-4 border-b border-[#222]">Top outbound tool clicks</h2>
            {outboundRows.length ? (
                <table class="w-full text-sm">
                    <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Tool</th><th>Clicks</th></tr></thead>
                    <tbody>{outboundRows.map(([slug, clicks]) => <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3"><a href={`/tools/${slug}`} class="hover:underline">{slug}</a></td><td>{clicks}</td></tr>)}</tbody>
                </table>
            ) : <p class="text-[#737373] p-5">No outbound clicks in this range.</p>}
        </section>

        <section class="border border-[#222] rounded-lg overflow-hidden mt-6">
            <h2 class="font-semibold px-5 py-4 border-b border-[#222]">Badge referrals by tool</h2>
            {badgeReferrals.length ? (
                <table class="w-full text-sm">
                    <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Tool</th><th>Visits</th></tr></thead>
                    <tbody>{badgeReferrals.map(([slug, visits]) => <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3">{slug === '(home)' ? slug : <a href={`/tools/${slug}`} class="hover:underline">{slug}</a>}</td><td>{visits}</td></tr>)}</tbody>
                </table>
            ) : <p class="text-[#737373] p-5">No badge referrals in this range.</p>}
        </section>
        <section class="mt-12" aria-labelledby="growth-heading">
            <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
                <div>
                    <h2 id="growth-heading" class="text-xl font-semibold">Growth baseline</h2>
                    <p class="text-[#737373] text-xs mt-1">Fixed windows of whole UTC days, independent of the range above. Δ compares the last 7 days with the 7 before.</p>
                </div>
            </div>

            {growthError && growthError !== analyticsError && (
                <div class="border border-amber-400/20 bg-amber-400/[0.06] text-amber-200 rounded-lg p-4 mb-6">{growthError}</div>
            )}
            {growth.truncated && (
                <div class="border border-amber-400/20 bg-amber-400/[0.06] text-amber-200 rounded-lg p-4 mb-6">Growth query hit its row limit; counts may be incomplete.</div>
            )}

            <h3 class="font-semibold mb-3">Weekly counts</h3>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-8">
                {[
                    { label: 'Visits', current: growth.visits.last7, previous: growth.visits.prev7 },
                    ...growth.weekly,
                ].map(({ label, current, previous }) => {
                    const delta = formatDelta(current, previous);
                    return (
                        <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                            <p class="text-[#737373] text-xs mb-2">{label} (7d)</p>
                            <div class="flex items-baseline justify-between gap-3">
                                <p class="font-mono text-2xl text-white">{current}</p>
                                <p class={`font-mono text-sm ${deltaClass(delta)}`}>{delta}</p>
                            </div>
                            <p class="text-[#737373] text-xs mt-2">prev 7d: {previous}</p>
                        </div>
                    );
                })}
                <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                    <p class="text-[#737373] text-xs mb-2">Email subscribers</p>
                    <p class="font-mono text-2xl text-[#737373]">—</p>
                    <p class="text-[#737373] text-xs mt-2">Not tracked until the newsletter ships (#373).</p>
                </div>
            </div>

            <h3 class="font-semibold mb-3">Returning visitors</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
                {[
                    ['Unique visitors (7d)', String(growth.visitors.last7), formatDelta(growth.visitors.last7, growth.visitors.prev7), `prev 7d: ${growth.visitors.prev7}`],
                    ['Came back the next week', formatRate(growth.weeklyReturn.rate), formatPointDelta(growth.weeklyReturn.rate, growth.weeklyReturn.previous), `Visitors 7-13 days ago seen again in the last 7. Prior week: ${formatRate(growth.weeklyReturn.previous)}`],
                    ['28-day return rate', formatRate(growth.monthlyReturn.rate), formatPointDelta(growth.monthlyReturn.rate, growth.monthlyReturn.previous), `Visitors seen on 2+ days in the last 28. Prior 28d: ${formatRate(growth.monthlyReturn.previous)}`],
                ].map(([label, value, delta, note]) => (
                    <div class="border border-[#222] bg-white/[0.02] rounded-lg p-5">
                        <p class="text-[#737373] text-xs mb-2">{label}</p>
                        <div class="flex items-baseline justify-between gap-3">
                            <p class="font-mono text-2xl text-white">{value}</p>
                            <p class={`font-mono text-sm ${deltaClass(delta!)}`}>{delta}</p>
                        </div>
                        <p class="text-[#737373] text-xs mt-2">{note}</p>
                    </div>
                ))}
            </div>
            <p class="text-[#737373] text-xs -mt-5 mb-8">Based on the anonymous browser ID; visitors with Do Not Track or Global Privacy Control are counted in visits but not here.</p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <section class="border border-[#222] rounded-lg overflow-hidden">
                    <h3 class="font-semibold px-5 py-4 border-b border-[#222]">Referrers by group</h3>
                    <table class="w-full text-sm">
                        <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Group</th><th>7d</th><th>Δ</th><th>28d</th></tr></thead>
                        <tbody>{growth.referrerGroups.map(row => {
                            const delta = formatDelta(row.last7, row.prev7);
                            return <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3">{groupLabels[row.group]}</td><td>{row.last7}</td><td class={`font-mono ${deltaClass(delta)}`}>{delta}</td><td>{row.last28}</td></tr>;
                        })}</tbody>
                    </table>
                </section>

                <section class="border border-[#222] rounded-lg overflow-hidden">
                    <h3 class="font-semibold px-5 py-4 border-b border-[#222]">Visits by ?ref=</h3>
                    {growth.refSources.length ? (
                        <table class="w-full text-sm">
                            <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Source</th><th>7d</th><th>Δ</th><th>28d</th></tr></thead>
                            <tbody>{growth.refSources.map(row => {
                                const delta = formatDelta(row.last7, row.prev7);
                                return <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3 font-mono">{row.source}</td><td>{row.last7}</td><td class={`font-mono ${deltaClass(delta)}`}>{delta}</td><td>{row.last28}</td></tr>;
                            })}</tbody>
                        </table>
                    ) : <p class="text-[#737373] p-5">No ?ref= visits in the last 28 days.</p>}
                </section>
            </div>

            <section class="border border-[#222] rounded-lg overflow-hidden">
                <h3 class="font-semibold px-5 py-4 border-b border-[#222]">Top referrer hosts</h3>
                {growth.referrerHosts.length ? (
                    <table class="w-full text-sm">
                        <thead class="text-[#737373] text-left"><tr><th class="px-5 py-3">Host</th><th>Group</th><th>7d</th><th>Δ</th><th>28d</th></tr></thead>
                        <tbody>{growth.referrerHosts.map(row => {
                            const delta = formatDelta(row.last7, row.prev7);
                            return <tr class="border-t border-[#1a1a1a]"><td class="px-5 py-3 font-mono">{row.host}</td><td>{groupLabels[referrerGroup(row.host)]}</td><td>{row.last7}</td><td class={`font-mono ${deltaClass(delta)}`}>{delta}</td><td>{row.last28}</td></tr>;
                        })}</tbody>
                    </table>
                ) : <p class="text-[#737373] p-5">No external referrers in the last 28 days.</p>}
            </section>
        </section>
    </div>
</DashboardLayout>
