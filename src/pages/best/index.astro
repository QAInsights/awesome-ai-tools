---
/**
 * Best-of hub - /best
 *
 * Crawlable index of the "Best X for Y" facet pages defined in
 * data/best-facets.json.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getBestPages } from '../../lib/best';
import { getIndexingDecisions } from '../../lib/indexing';
import FolioStyles from '../../components/folio/FolioStyles.astro';
import FolioTitle from '../../components/folio/FolioTitle.astro';
import FolioScroll from '../../components/folio/FolioScroll.astro';

const decisions = getIndexingDecisions();
const pages = getBestPages().filter(p => decisions.get(`/best/${p.facet.slug}`)?.indexable);
const refreshLabel = getBestPages()[0]?.refreshLabel ?? '';
const pageUrl = 'https://ai.dosa.dev/best';
const description = `Ranked lists of the best AI coding tools by use case: free, open source, self-hosted, JetBrains, VS Code, terminal, enterprise, beginners, Python and TypeScript. Refreshed ${refreshLabel}.`;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "CollectionPage",
            "@id": `${pageUrl}#collection`,
            "url": pageUrl,
            "name": "Best AI Coding Tools by Use Case",
            "description": description,
            "inLanguage": "en",
            "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
        },
        {
            "@type": "ItemList",
            "numberOfItems": pages.length,
            "itemListElement": pages.map((p, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "name": p.facet.title,
                "url": `https://ai.dosa.dev/best/${p.facet.slug}`
            }))
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
                { "@type": "ListItem", "position": 2, "name": "Best AI coding tools", "item": pageUrl }
            ]
        }
    ]
});
---

<BaseLayout
    title={`Best AI Coding Tools by Use Case (${refreshLabel}) | ai.dosa.dev`}
    description={description}
    keywords="best AI coding tools, best AI coding assistant, best free AI coding agent, best AI coding tools for JetBrains, best AI coding tools for VS Code"
    canonical={pageUrl}
    jsonLd={jsonLd}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" title="Best AI coding tools" />

            <article class="fo">
                <header class="fo-hero">
                    <div>
                        <div class="fo-top fo-fade" style="--d:.1s">
                            <nav aria-label="Breadcrumb" class="fo-crumbs">
                                <a href="/">Home</a><span>/</span>
                                <span class="here">Best</span>
                            </nav>
                            {refreshLabel && <span class="fo-status"><span>Refreshed {refreshLabel}</span></span>}
                        </div>
                        <div class="fo-rule"></div>
                    </div>
                    <div>
                        <FolioTitle parts={[{ text: 'Best AI Coding Tools' }, { text: 'by Use Case', plain: true }]} size="md" />
                        <div class="fo-intro">
                            <p class="fo-lead fo-fade" style="--d:.55s">
                                Ranked shortlists for the questions developers actually ask: which tools are free, which run locally, which work in JetBrains or the terminal, and which pass an enterprise security review. Each list is rebuilt from the directory's reviews every month.
                            </p>
                            <div class="fo-price fo-fade" style="--d:.7s">
                                <small>Lists</small>
                                <b>{pages.length}</b>
                                <span>ranked shortlists</span>
                            </div>
                        </div>
                    </div>
                </header>

                <section class="fo-sec" id="lists" aria-label="Best-of lists">
                    <h2 class="fo-label"><em>01</em>The lists</h2>
                    <div class="fo-body">
                        {pages.map((p, i) => (
                            <div class="fo-rank">
                                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                                <div>
                                    <h3><a href={`/best/${p.facet.slug}`}>{p.facet.title}</a></h3>
                                    <p>Top picks: {p.tools.slice(0, 3).map(t => t.enriched?.name ?? t.name).join(', ')}</p>
                                </div>
                                <span class="pr">{p.tools.length} tools</span>
                            </div>
                        ))}
                    </div>
                </section>

                <div class="fo-notes">
                    <span>Rankings are rebuilt monthly from the directory's reviews. Verify details on each vendor's website.</span>
                    <a class="back" href="/compare">All comparisons →</a>
                </div>
            </article>
        </main>
    </div>

    <FolioStyles />
    <FolioScroll />
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
