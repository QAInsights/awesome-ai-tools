---
/**
 * "Best X for Y" facet page - /best/[slug]
 *
 * One page per facet in data/best-facets.json. The ranked list is computed
 * from enrichment at build time (src/lib/best.ts) and re-dated monthly.
 * Pages listing fewer than 5 qualifying tools render noindex (see
 * src/lib/indexing.ts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatDate, getCategorySlug, getToolBySlug } from '../../lib/tools';
import { getBestFreePick, getBestPages, type BestPage } from '../../lib/best';
import { ORGANIZATION } from '../../lib/site';
import { robotsFor } from '../../lib/indexing';
import { getComparisonsForTool, hasAlternativesPage, humanizePricing, truncate } from '../../lib/compare';
import { entryLabel } from '../../lib/folio';
import FolioStyles from '../../components/folio/FolioStyles.astro';
import FolioTitle from '../../components/folio/FolioTitle.astro';
import FolioFaq from '../../components/folio/FolioFaq.astro';
import FolioScroll from '../../components/folio/FolioScroll.astro';

export async function getStaticPaths() {
    return getBestPages().map(page => ({
        params: { slug: page.facet.slug },
        props: { page },
    }));
}

interface Props {
    page: BestPage;
}

const { page } = Astro.props;
const { facet, tools, comparisons, refreshLabel, lastmod } = page;
const count = tools.length;
const nameOf = (slug: string) => {
    const t = getToolBySlug(slug);
    return t?.enriched?.name ?? t?.name ?? slug;
};
const topNames = tools.slice(0, 3).map(t => t.enriched?.name ?? t.name);
const top = tools[0];
const freePick = getBestFreePick(page);
const ogImage = `https://ai.dosa.dev/images/og/best/${facet.slug}.png`;

const pageUrl = `https://ai.dosa.dev/best/${facet.slug}`;
const title = `${count} ${facet.title} (${refreshLabel}) | ai.dosa.dev`;
const descMeta = truncate(`${facet.title}, ranked for ${refreshLabel}: ${topNames.join(', ')}${count > 3 ? ` and ${count - 3} more` : ''}. Compare pricing, best-for and verdicts side by side.`, 155);

const faqs: { q: string; a: string }[] = [];
if (top) {
    const topName = top.enriched?.name ?? top.name;
    faqs.push({
        q: `What are the best ${facet.keyword} in ${refreshLabel}?`,
        a: `${topName} ranks first for ${refreshLabel}.${top.enriched?.verdict ? ` ${top.enriched.verdict}` : ''}${topNames.length > 1 ? ` Also consider ${topNames.slice(1).join(' and ')}.` : ''}`,
    });
}
faqs.push({ q: 'How are these tools ranked?', a: `${facet.criteria} The list is rebuilt from the directory's reviews every month.` });
const freeCount = tools.filter(t => ['free', 'open-source'].includes((t.enriched?.pricing ?? '').toLowerCase())).length;
if (freeCount > 0 && facet.slug !== 'free-ai-coding-tools') {
    faqs.push({ q: `Are any of these ${facet.short} tools free?`, a: `${freeCount} of the ${count} tools listed are free or open source. See the comparison table for each tool's pricing model.` });
}

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "CollectionPage",
            "@id": `${pageUrl}#collection`,
            "url": pageUrl,
            "name": facet.title,
            "description": descMeta,
            "inLanguage": "en",
            "dateModified": lastmod,
            "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
            "publisher": ORGANIZATION,
            "author": { "@id": ORGANIZATION["@id"] },
            "mainEntity": { "@id": `${pageUrl}#list` },
            "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 630 },
            "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".best-intro", ".best-answer"] },
        },
        {
            "@type": "ItemList",
            "@id": `${pageUrl}#list`,
            "name": facet.title,
            "itemListOrder": "https://schema.org/ItemListOrderAscending",
            "numberOfItems": count,
            "itemListElement": tools.map((t, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "item": {
                    "@type": "SoftwareApplication",
                    "@id": `https://ai.dosa.dev/tools/${t.slug}#app`,
                    "name": t.enriched?.name ?? t.name,
                    "url": `https://ai.dosa.dev/tools/${t.slug}`,
                    "applicationCategory": "DeveloperApplication",
                    "applicationSubCategory": t.categoryClean,
                    ...(t.enriched?.description ? { "description": t.enriched.description } : {}),
                }
            }))
        },
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map(f => ({
                "@type": "Question",
                "name": f.q,
                "acceptedAnswer": { "@type": "Answer", "text": f.a }
            }))
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
                { "@type": "ListItem", "position": 2, "name": "Best AI coding tools", "item": "https://ai.dosa.dev/best" },
                { "@type": "ListItem", "position": 3, "name": facet.title, "item": pageUrl }
            ]
        }
    ]
});

const otherPages = getBestPages().filter(p => p.facet.slug !== facet.slug);
const topName = top ? top.enriched?.name ?? top.name : '';
const facts = [
    { k: 'Top pick', v: topName || '—' },
    freePick
        ? { k: 'Best free option', v: freePick.enriched?.name ?? freePick.name }
        : { k: 'Categories', v: String(new Set(tools.map(t => t.categoryShort)).size) },
    { k: 'Free or open source', v: String(freeCount) },
    { k: 'Head-to-head pages', v: String(comparisons.length) },
];
let n = 0;
const num = () => String(++n).padStart(2, '0');
---

<BaseLayout
    title={title}
    description={descMeta}
    keywords={`best ${facet.keyword}, ${facet.keyword}, ${facet.keyword} ${page.refreshMonth.slice(0, 4)}, ${facet.short} AI coding tools`}
    canonical={pageUrl}
    robots={robotsFor(`/best/${facet.slug}`)}
    jsonLd={jsonLd}
    ogImage={ogImage}
    ogType="article"
    modifiedTime={lastmod}
    markdownUrl={`/best/${facet.slug}.md`}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" title={facet.title} />

            <article class="fo">
                <header class="fo-hero">
                    <div>
                        <div class="fo-top fo-fade" style="--d:.1s">
                            <nav aria-label="Breadcrumb" class="fo-crumbs">
                                <a href="/">Home</a><span>/</span>
                                <a href="/best">Best</a><span>/</span>
                                <span class="here">{facet.short}</span>
                            </nav>
                            <span class="fo-status"><span>Updated <time datetime={lastmod}>{formatDate(lastmod)}</time></span></span>
                        </div>
                        <div class="fo-rule"></div>
                    </div>
                    <div>
                        <FolioTitle parts={[{ text: facet.title }, { text: `(${refreshLabel})`, plain: true }]} size="sm" />
                        <div class="fo-intro">
                            <div class="fo-leadbox fo-fade" style="--d:.55s">
                                <p class="fo-lead best-intro">{facet.intro}</p>
                                <p class="fo-note">How we rank: {facet.criteria}</p>
                            </div>
                            <div class="fo-price fo-fade" style="--d:.7s">
                                <small>Ranked</small>
                                <b>{count}</b>
                                <span>tools · refreshed {refreshLabel}</span>
                            </div>
                            <div class="fo-cta fo-fade" style="--d:.85s">
                                {top && <a class="fo-btn" href={`/tools/${top.slug}`}>{topName} review <i aria-hidden="true">→</i></a>}
                                <a class="fo-link" href={`/best/${facet.slug}.md`}>Markdown</a>
                            </div>
                        </div>
                        <div class="fo-facts">
                            {facts.map((f, i) => (
                                <div class="fo-fact fo-fade" style={`--d:${0.9 + i * 0.08}s`}>
                                    <span class="fo-k">{f.k}</span>
                                    <b>{f.v}</b>
                                </div>
                            ))}
                        </div>
                    </div>
                </header>

                {top && (
                    <section class="fo-sec" id="answer" aria-labelledby="answer-heading">
                        <h2 class="fo-label" id="answer-heading"><em>{num()}</em>Quick answer</h2>
                        <div class="fo-body best-answer fo-reveal">
                            <p class="fo-text sm">
                                Top pick: <a href={`/tools/${top.slug}`}>{topName}</a> ({humanizePricing(top.enriched?.pricing)}). {top.enriched?.verdict}
                            </p>
                            {freePick && (
                                <p class="fo-note">Best free option: <a href={`/tools/${freePick.slug}`}>{freePick.enriched?.name ?? freePick.name}</a>. {freePick.enriched?.bestFor}</p>
                            )}
                            {topNames.length > 1 && <p class="fo-note">Also strong: {topNames.slice(1).join(', ')}.</p>}
                        </div>
                    </section>
                )}

                <section class="fo-sec" id="glance" aria-labelledby="comparison-heading">
                    <h2 class="fo-label" id="comparison-heading"><em>{num()}</em>At a glance</h2>
                    <div class="fo-body">
                        <table class="fo-glance">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Tool</th>
                                    <th scope="col">Pricing</th>
                                    <th scope="col" class="hm">Category</th>
                                    <th scope="col" class="hs">Best for</th>
                                </tr>
                            </thead>
                            <tbody>
                                {tools.map((t, i) => (
                                    <tr>
                                        <td class="no">{String(i + 1).padStart(2, '0')}</td>
                                        <td class="t">
                                            <a href={`/tools/${t.slug}`}>{t.enriched?.name ?? t.name}</a>
                                            <small>{t.enriched?.company ?? t.company}</small>
                                        </td>
                                        <td class="pr">{humanizePricing(t.enriched?.pricing)}</td>
                                        <td class="hm"><a href={`/category/${getCategorySlug(t.categoryShort)}`}>{t.categoryShort}</a></td>
                                        <td class="hs">{truncate(t.enriched?.bestFor, 110)}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="fo-sec" id="ranked" aria-labelledby="ranked-heading">
                    <h2 class="fo-label" id="ranked-heading"><em>{num()}</em>Ranked list</h2>
                    <div class="fo-body">
                        {tools.map((t, i) => {
                            const name = t.enriched?.name ?? t.name;
                            const pairs = getComparisonsForTool(t.slug).slice(0, 2);
                            return (
                                <div class="fo-rank">
                                    <span class="no">{String(i + 1).padStart(2, '0')}</span>
                                    <div>
                                        <h3><a href={`/tools/${t.slug}`}>{name}</a><span class="co">{t.enriched?.company ?? t.company}</span></h3>
                                        <p>{t.enriched?.verdict ?? t.enriched?.description ?? t.notes}</p>
                                        <div class="links">
                                            <a href={`/tools/${t.slug}`}>{name} review →</a>
                                            {hasAlternativesPage(t.slug) && <a href={`/tools/${t.slug}/alternatives`}>{name} alternatives →</a>}
                                            {pairs.map(c => <a class="g" href={`/compare/${c.slug}`}>{name} vs {nameOf(c.a === t.slug ? c.b : c.a)} →</a>)}
                                        </div>
                                    </div>
                                    <span class="pr">{entryLabel(t)}</span>
                                </div>
                            );
                        })}
                    </div>
                </section>

                {comparisons.length > 0 && (
                    <section class="fo-sec" id="compare" aria-labelledby="head-to-head-heading">
                        <h2 class="fo-label" id="head-to-head-heading"><em>{num()}</em>Head-to-head</h2>
                        <div class="fo-body">
                            {comparisons.map(c => (
                                <a class="fo-alt" href={`/compare/${c.slug}`}>
                                    <span><b>{nameOf(c.a)} vs {nameOf(c.b)}</b></span>
                                    <small></small>
                                    <span class="pr"></span>
                                    <i aria-hidden="true">→</i>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                <section class="fo-sec" id="faq" aria-label="Frequently asked questions">
                    <h2 class="fo-label"><em>{num()}</em>FAQ</h2>
                    <FolioFaq faqs={faqs} />
                </section>

                <nav class="fo-sec" id="more" aria-label="More best-of lists">
                    <h2 class="fo-label"><em>{num()}</em>More lists</h2>
                    <div class="fo-body">
                        <ul class="fo-tags">
                            {otherPages.map(p => <li><a href={`/best/${p.facet.slug}`}>{p.facet.title}</a></li>)}
                            <li><a href="/compare">All comparisons</a></li>
                        </ul>
                    </div>
                </nav>

                <div class="fo-notes">
                    <span>Rankings are rebuilt monthly from the directory's reviews. Verify details on each vendor's website.</span>
                    <a class="back" href="/best">← All best-of lists</a>
                </div>
            </article>
        </main>
    </div>

    <FolioStyles />
    <FolioScroll />
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
