---
/**
 * Category landing page - /category/[slug]
 *
 * Thin wrapper: renders the shared CategoryPage component for the English
 * locale. The zh mirror lives at src/pages/zh/category/[slug].astro.
 */
import CategoryPage from '../../components/pages/CategoryPage.astro';
import { getCategoriesDetailed, type CategoryInfo } from '../../lib/tools';

export async function getStaticPaths() {
    return getCategoriesDetailed().map(category => ({
        params: { slug: category.slug },
        props: { category },
    }));
}

interface Props {
    category: CategoryInfo;
}

const { category } = Astro.props;
---

<CategoryPage category={category} lang="en" />
