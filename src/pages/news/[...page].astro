---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PostCard from '../../components/PostCard.astro';

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  allPosts: CollectionEntry<'blog'>[];
}

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) =>
    data.draft !== true && data.tags?.includes('news')
  );
  const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 6, props: { allPosts: posts } });
}) satisfies GetStaticPaths;

const { page, allPosts } = Astro.props;
const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const popularTags = [...tagCounts.entries()]
  .filter(([tag]) => tag !== 'news' && tag !== 'today-in-ai')
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10);

const newsDescription = 'A daily AI brief covering model releases, developer tools, business moves, and policy that affects builders.';
const newsUrl = `https://ai.dosa.dev/news${page.currentPage > 1 ? `/${page.currentPage}` : ''}`;
const absUrl = (u: string | undefined) => (u ? new URL(u, 'https://ai.dosa.dev').href : undefined);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": newsUrl,
      "url": newsUrl,
      "name": "Today in AI - daily AI news brief for developers",
      "description": newsDescription,
      "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
      "publisher": { "@id": "https://ai.dosa.dev/#organization" },
      "inLanguage": "en",
      ...(allPosts[0] ? { "dateModified": allPosts[0].data.pubDate.toISOString() } : {}),
    },
    {
      "@type": "ItemList",
      "name": "Today in AI briefs",
      "numberOfItems": page.data.length,
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "itemListElement": page.data.map((post, i) => ({
        "@type": "ListItem",
        "position": page.start + i + 1,
        "url": `https://ai.dosa.dev/blog/${post.id}`,
        "name": post.data.title,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
        { "@type": "ListItem", "position": 2, "name": "Today in AI", "item": "https://ai.dosa.dev/news" },
      ],
    },
  ],
});
---

<DashboardLayout
  title={`Today in AI | ai.dosa.dev${page.currentPage > 1 ? ` (Page ${page.currentPage})` : ''}`}
  description={newsDescription}
  canonical={newsUrl}
  keywords="AI news today, daily AI brief, LLM model releases, AI developer tools news, ai.dosa.dev"
  prevUrl={absUrl(page.url.prev)}
  nextUrl={absUrl(page.url.next)}
  jsonLd={jsonLd}
  activeNav="news"
>
  <div class="max-w-[1400px] mx-auto w-full flex flex-col grow shrink-0 p-6 md:p-8">
    <div class="max-w-4xl mx-auto flex flex-col flex-1 w-full">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-3">
        <h1 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">Today in AI</h1>
        <a href="/news/rss.xml" class="inline-flex items-center gap-1.5 text-[14px] font-mono text-[#8a8a8a] hover:text-[#22d3ee] transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
          </svg>
          RSS feed
        </a>
      </div>
      <p class="text-[#b4b4b4] text-base sm:text-lg leading-relaxed mb-6">
        A daily AI brief for builders: the launches, funding, tooling, and policy moves that matter.
      </p>

      {popularTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 mb-8">
          <span class="text-[13px] font-mono uppercase tracking-widest text-[#8a8a8a] mr-1">Topics</span>
          {popularTags.map(([tag, count]) => (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[#333] text-[13px] font-mono bg-white/[0.03] text-[#b4b4b4]">
              {tag}<span class="text-[#737373]">{count}</span>
            </span>
          ))}
        </div>
      )}

      {page.data.length === 0 && (
        <div class="border border-dashed border-[#222] rounded-lg bg-white/[0.01] p-8 text-center">
          <p class="text-[#b4b4b4] text-base leading-relaxed mb-1">No brief published yet.</p>
          <p class="text-[#737373] text-sm font-mono">A new edition lands every day at 00:30 UTC.</p>
        </div>
      )}

      <div class="space-y-6">
        {page.data.map((post) => (
          <PostCard post={post} hideFeedTags headingLevel="h2" />
        ))}
      </div>

      {page.lastPage > 1 && (
        <div class="mt-12 flex items-center justify-between border-t border-[#222] pt-6">
          {page.url.prev ? (
            <a href={page.url.prev} class="inline-flex items-center justify-center py-2 px-4 bg-white/5 text-white text-sm font-medium border border-[#222] rounded-md transition-all hover:bg-white/10 hover:-translate-y-px">
              &larr; Newer Briefs
            </a>
          ) : (
            <div></div>
          )}
          <div class="text-sm font-mono text-[#737373]">
            Page {page.currentPage} of {page.lastPage}
          </div>
          {page.url.next ? (
            <a href={page.url.next} class="inline-flex items-center justify-center py-2 px-4 bg-white/5 text-white text-sm font-medium border border-[#222] rounded-md transition-all hover:bg-white/10 hover:-translate-y-px">
              Older Briefs &rarr;
            </a>
          ) : (
            <div></div>
          )}
        </div>
      )}

      <footer class="pt-12 pb-6 text-center mt-auto">
        <span class="font-mono text-xs text-[#525252]">© {new Date().getFullYear()} dosa.dev</span>
      </footer>
    </div>
  </div>
</DashboardLayout>
