---
/**
 * Static comparison page - /compare/[pair]
 *
 * One pre-rendered page per curated pair from data/comparisons.json.
 * All content is derived at build time from enriched tool data - no
 * client-side fetch - so search engines and AI crawlers get the full
 * comparison table, FAQs, and verdicts in the initial HTML.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import {
    getResolvedComparisons,
    buildComparisonFaqs,
    comparisonQuickAnswer,
    humanizePricing,
    type ResolvedComparison,
} from '../../lib/compare';
import { formatDate, getCategorySlug } from '../../lib/tools';
import { robotsFor } from '../../lib/indexing';
import { ORGANIZATION } from '../../lib/site';
import { addOutboundUtmParams } from '../../lib/outbound-utm.js';
import { priceSummary } from '../../lib/folio';
import FolioStyles from '../../components/folio/FolioStyles.astro';
import FolioTitle from '../../components/folio/FolioTitle.astro';
import FolioFaq from '../../components/folio/FolioFaq.astro';
import FolioScroll from '../../components/folio/FolioScroll.astro';

export async function getStaticPaths() {
    return getResolvedComparisons().map(comparison => ({
        params: { pair: comparison.slug },
        props: { comparison },
    }));
}

interface Props {
    comparison: ResolvedComparison;
}

const { comparison } = Astro.props;
const { toolA, toolB } = comparison;

const nameA = toolA.name;
const nameB = toolB.name;
const pageUrl = `https://ai.dosa.dev/compare/${comparison.slug}`;

const ogImage = `https://ai.dosa.dev/images/og/compare/${comparison.slug}.png`;
const quickAnswer = comparisonQuickAnswer(toolA, toolB);
const faqs = buildComparisonFaqs(toolA, toolB);
const lastUpdatedLabel = formatDate(comparison.lastUpdated);

const related = getResolvedComparisons()
    .filter(c => c.slug !== comparison.slug && (c.a === toolA.slug || c.b === toolA.slug || c.a === toolB.slug || c.b === toolB.slug))
    .slice(0, 6);

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#page`,
            "url": pageUrl,
            "name": `${nameA} vs ${nameB} - Pricing, Features, Verdict`,
            "description": `Side-by-side comparison of ${nameA} and ${nameB}: pricing, key features, ideal use cases, and verdicts.`,
            "inLanguage": "en",
            ...(comparison.lastUpdated ? { "dateModified": comparison.lastUpdated } : {}),
            "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
            "publisher": ORGANIZATION,
            "author": { "@id": ORGANIZATION["@id"] },
            "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 630 },
            "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".cmp-intro", ".cmp-answer"] },
            "about": [toolA, toolB].map(t => ({
                "@type": "SoftwareApplication",
                "name": t.name,
                "url": t.url || `https://ai.dosa.dev/tools/${t.slug}`,
                "applicationCategory": "DeveloperApplication",
            })),
        },
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map(f => ({
                "@type": "Question",
                "name": f.q,
                "acceptedAnswer": { "@type": "Answer", "text": f.a }
            }))
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
                { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://ai.dosa.dev/compare" },
                { "@type": "ListItem", "position": 3, "name": `${nameA} vs ${nameB}`, "item": pageUrl }
            ]
        }
    ]
});


const sides = [toolA, toolB].map(t => ({
    t,
    price: priceSummary(t.enriched?.pricing, t.enriched?.pricingDetail),
    siteHref: /^https?:\/\//i.test(t.url ?? '') ? addOutboundUtmParams(t.url) : '',
}));
const facts = [
    ...sides.map(({ t, price }) => ({ k: `${t.name} from`, v: price.entry ? `${price.entry.price}${price.entry.unit}` : price.main })),
    { k: 'Category', v: comparison.group },
    { k: 'Updated', v: lastUpdatedLabel || '—' },
];
const hasChoose = Boolean(toolA.enriched?.bestFor || toolB.enriched?.bestFor);
const sections = ['answer', 'tools', hasChoose && 'choose', 'table', 'faq', related.length && 'more'].filter(Boolean) as string[];
const num = (id: string) => String(sections.indexOf(id) + 1).padStart(2, '0');

---

<BaseLayout
    title={`${nameA} vs ${nameB} (2026): Pricing, Features, Verdict | ai.dosa.dev`}
    description={`${nameA} vs ${nameB} compared: pricing, key features, who each tool is best for, recent updates, and verdicts. Updated ${lastUpdatedLabel || 'regularly'}.`}
    keywords={`${nameA} vs ${nameB}, ${nameA} alternative, ${nameB} alternative, ${comparison.group}, AI coding tools comparison`}
    canonical={pageUrl}
    robots={robotsFor(`/compare/${comparison.slug}`)}
    jsonLd={jsonLd}
    ogImage={ogImage}
    ogType="article"
    modifiedTime={comparison.lastUpdated ?? undefined}
    markdownUrl={`/compare/${comparison.slug}.md`}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" title={`${nameA} vs ${nameB}`} />

            <article class="fo">
                <header class="fo-hero">
                    <div>
                        <div class="fo-top fo-fade" style="--d:.1s">
                            <nav aria-label="Breadcrumb" class="fo-crumbs">
                                <a href="/">Home</a><span>/</span>
                                <a href="/compare">Compare</a><span>/</span>
                                <span class="here">{nameA} vs {nameB}</span>
                            </nav>
                            {lastUpdatedLabel && <span class="fo-status"><span>Updated {lastUpdatedLabel}</span></span>}
                        </div>
                        <div class="fo-rule"></div>
                    </div>
                    <div>
                        <FolioTitle parts={[{ text: nameA }, { text: 'vs', plain: true }, { text: nameB }]} size="lg" />
                        <div class="fo-intro">
                            <p class="fo-lead cmp-intro fo-fade" style="--d:.55s">
                                Side-by-side comparison of {nameA} ({toolA.company}) and {nameB} ({toolB.company}) - pricing, key features, ideal use cases, recent updates, and verdicts.
                            </p>
                            <div class="fo-cta fo-fade" style="--d:.85s">
                                <a class="fo-link" href="/compare">All comparisons</a>
                            </div>
                        </div>
                        <div class="fo-facts">
                            {facts.map((f, i) => (
                                <div class="fo-fact fo-fade" style={`--d:${0.9 + i * 0.08}s`}>
                                    <span class="fo-k">{f.k}</span>
                                    <b>{f.v}</b>
                                </div>
                            ))}
                        </div>
                    </div>
                </header>

                <section class="fo-sec" id="answer" aria-label="Quick answer">
                    <h2 class="fo-label"><em>{num('answer')}</em>Quick answer</h2>
                    <div class="fo-body">
                        <p class="fo-text sm cmp-answer fo-reveal">{quickAnswer}</p>
                    </div>
                </section>

                <section class="fo-sec" id="tools" aria-label="Tool summaries">
                    <h2 class="fo-label"><em>{num('tools')}</em>The two tools</h2>
                    <div class="fo-body fo-duo">
                        {sides.map(({ t, price, siteHref }) => (
                            <div>
                                <h3><a href={`/tools/${t.slug}`}>{t.name}</a></h3>
                                <span class="co">{t.company}</span>
                                <b class="big">{price.main}</b>
                                <span class="u">{price.unit}{t.enriched?.pricing && ` · ${humanizePricing(t.enriched.pricing)}`}</span>
                                <p>{t.enriched?.description ?? t.notes}</p>
                                <div class="acts">
                                    <a class="fo-btn" href={`/tools/${t.slug}`}>Full review <i aria-hidden="true">→</i></a>
                                    {siteHref && <a class="fo-link" href={siteHref} target="_blank" rel="noopener noreferrer">Visit site ↗</a>}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                {hasChoose && (
                    <section class="fo-sec" id="choose" aria-label="How to choose">
                        <h2 class="fo-label"><em>{num('choose')}</em>How to choose</h2>
                        <div class="fo-body fo-duo">
                            {[toolA, toolB].map(t => (
                                <div>
                                    <h3>Choose {t.name} if</h3>
                                    <p>{t.enriched?.bestFor ?? '-'}</p>
                                    {t.enriched?.notIdealFor && <p class="skip"><b>Skip if:</b> {t.enriched.notIdealFor}</p>}
                                </div>
                            ))}
                        </div>
                    </section>
                )}

                <section class="fo-sec" id="table" aria-label="Detailed comparison">
                    <h2 class="fo-label"><em>{num('table')}</em>Detailed comparison</h2>
                    <div class="fo-body">
                        <table class="fo-ctable">
                            <caption class="sr-only">{nameA} vs {nameB}: pricing, features, and use cases compared</caption>
                            <thead>
                                <tr>
                                    <th scope="col"></th>
                                    <th scope="col"><a href={`/tools/${toolA.slug}`}>{nameA}</a></th>
                                    <th scope="col"><a href={`/tools/${toolB.slug}`}>{nameB}</a></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th scope="row">Company</th>
                                    <td>{toolA.company}</td>
                                    <td>{toolB.company}</td>
                                </tr>
                                <tr>
                                    <th scope="row">Category</th>
                                    <td><a href={`/category/${getCategorySlug(toolA.categoryShort)}`}>{toolA.categoryClean}</a></td>
                                    <td><a href={`/category/${getCategorySlug(toolB.categoryShort)}`}>{toolB.categoryClean}</a></td>
                                </tr>
                                <tr>
                                    <th scope="row">Pricing</th>
                                    <td>
                                        {humanizePricing(toolA.enriched?.pricing)}
                                        {toolA.enriched?.pricingDetail && <small>{toolA.enriched.pricingDetail}</small>}
                                    </td>
                                    <td>
                                        {humanizePricing(toolB.enriched?.pricing)}
                                        {toolB.enriched?.pricingDetail && <small>{toolB.enriched.pricingDetail}</small>}
                                    </td>
                                </tr>
                                {(toolA.enriched?.keyFeatures || toolB.enriched?.keyFeatures) && (
                                    <tr>
                                        <th scope="row">Key features</th>
                                        <td>{toolA.enriched?.keyFeatures ? <ul>{toolA.enriched.keyFeatures.map(f => <li>{f}</li>)}</ul> : '-'}</td>
                                        <td>{toolB.enriched?.keyFeatures ? <ul>{toolB.enriched.keyFeatures.map(f => <li>{f}</li>)}</ul> : '-'}</td>
                                    </tr>
                                )}
                                <tr>
                                    <th scope="row">Best for</th>
                                    <td>{toolA.enriched?.bestFor ?? '-'}</td>
                                    <td>{toolB.enriched?.bestFor ?? '-'}</td>
                                </tr>
                                <tr>
                                    <th scope="row">Not ideal for</th>
                                    <td>{toolA.enriched?.notIdealFor ?? '-'}</td>
                                    <td>{toolB.enriched?.notIdealFor ?? '-'}</td>
                                </tr>
                                {(toolA.enriched?.recentUpdates || toolB.enriched?.recentUpdates) && (
                                    <tr>
                                        <th scope="row">Recent updates</th>
                                        <td>{toolA.enriched?.recentUpdates ?? '-'}</td>
                                        <td>{toolB.enriched?.recentUpdates ?? '-'}</td>
                                    </tr>
                                )}
                                {(toolA.enriched?.verdict || toolB.enriched?.verdict) && (
                                    <tr>
                                        <th scope="row">Verdict</th>
                                        <td><em>{toolA.enriched?.verdict ?? '-'}</em></td>
                                        <td><em>{toolB.enriched?.verdict ?? '-'}</em></td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="fo-sec" id="faq" aria-label="Frequently asked questions">
                    <h2 class="fo-label"><em>{num('faq')}</em>FAQ</h2>
                    <FolioFaq faqs={faqs} />
                </section>

                {related.length > 0 && (
                    <nav class="fo-sec" id="more" aria-label="Related comparisons">
                        <h2 class="fo-label"><em>{num('more')}</em>More comparisons</h2>
                        <div class="fo-body">
                            <ul class="fo-tags">
                                {related.map(c => <li><a href={`/compare/${c.slug}`}>{c.toolA.name} vs {c.toolB.name}</a></li>)}
                            </ul>
                            <div class="fo-more"><a href="/compare">All comparisons →</a></div>
                        </div>
                    </nav>
                )}

                <div class="fo-notes">
                    <span>Comparison content is generated from our enriched tool data. Verify pricing and features with each vendor before purchasing.</span>
                    <a class="back" href="/compare">← All comparisons</a>
                </div>
            </article>
        </main>
    </div>

    <FolioStyles />
    <FolioScroll />
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
