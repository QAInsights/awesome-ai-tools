---
/**
 * Monthly AI Coding Cost Calculator - /tools/cost-calculator
 *
 * Interactive calculator combining:
 *   1. Paid seat / subscription plans from our catalog (`pricing-breakdown.ts`)
 *   2. Live & cached LLM API token pricing from https://models.dev/api.json (`/api/v1/models.json`)
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getAllTools } from '../../lib/tools';
import { buildCalculatorToolCatalog } from '../../lib/cost-calculator';

const catalog = buildCalculatorToolCatalog(getAllTools());
const safeCatalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://ai.dosa.dev/tools/cost-calculator#app',
      name: 'Monthly AI Coding Cost Calculator',
      url: 'https://ai.dosa.dev/tools/cost-calculator',
      description:
        'Interactive AI coding cost calculator. Combine seat subscriptions (Cursor, GitHub Copilot, Windsurf, Claude Code) with live LLM token pricing from models.dev to estimate monthly team burn and discover cheaper alternatives.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Combine seat subscriptions and BYOK LLM API token costs',
        'Live cached LLM token pricing from models.dev',
        'Prompt cache hit ratio and daily token workload presets',
        'Automatic cheaper tool and open-source BYOK savings recommendations',
      ],
      isPartOf: { '@type': 'WebSite', '@id': 'https://ai.dosa.dev/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ai.dosa.dev' },
        { '@type': 'ListItem', position: 2, name: 'AI Cost Calculator', item: 'https://ai.dosa.dev/tools/cost-calculator' },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<DashboardLayout
  title="Monthly AI Coding Cost Calculator — Seat + LLM Token Estimator | ai.dosa.dev"
  description="Calculate your team's monthly and annual AI coding stack cost. Combine Cursor, Copilot, Claude Code, and BYOK LLM API token spend with live models.dev pricing and cheaper alternatives."
  canonical="https://ai.dosa.dev/tools/cost-calculator"
  activeNav="cost-calculator"
>
  <script type="application/ld+json" set:html={jsonLd} />
  <script id="cost-calculator-catalog" type="application/json" set:html={safeCatalogJson} />

  <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
    <div class="max-w-[1200px] mx-auto w-full flex flex-col grow shrink-0 p-5 md:p-8 gap-6">
      <!-- Editorial Header -->
      <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-[#1d1d1c]">
        <div class="min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#d6b77a] mb-2">Interactive Utility · Live Pricing</p>
          <h1 class="text-2xl md:text-3xl font-semibold tracking-tight flex items-center gap-2.5 text-[#f4f4f2]">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-[#d6b77a] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="2" width="16" height="20" rx="2" />
              <line x1="8" y1="6" x2="16" y2="6" />
              <line x1="8" y1="11" x2="10" y2="11" />
              <line x1="14" y1="11" x2="16" y2="11" />
              <line x1="8" y1="15" x2="10" y2="15" />
              <line x1="14" y1="15" x2="16" y2="15" />
            </svg>
            Monthly AI Coding Cost Calculator
          </h1>
          <p class="text-[#a3a3a3] text-sm leading-relaxed mt-1.5 max-w-[68ch]">
            Combine seat subscriptions from our catalog with live LLM token pricing from
            <a href="https://models.dev" target="_blank" rel="noopener" class="text-[#e2c48a] hover:text-[#fff4de] underline underline-offset-2 transition-colors">models.dev</a>
            to forecast team spend and uncover cheaper alternatives.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <button id="copySummaryBtn" type="button" class="cc-action-btn">Copy Summary</button>
          <button id="shareCalcBtn" type="button" class="cc-action-btn cc-action-btn-primary">Share Stack</button>
        </div>
      </header>

      <!-- Main 2-column grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left Configurator (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-5">
          <!-- 1. Team Size & Billing -->
          <section class="cc-panel">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div>
                <div class="cc-label">01 · Team & Billing</div>
                <p class="text-xs text-[#737373] mt-0.5">Scale from solo builders to 25,000+ enterprise engineering orgs.</p>
              </div>
              <div class="inline-flex rounded-lg p-0.5 bg-[#111] border border-[#222] shrink-0">
                <button type="button" data-cycle="monthly" class="cc-cycle-btn active">Monthly</button>
                <button type="button" data-cycle="annual" class="cc-cycle-btn">Annual View</button>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1 flex flex-col gap-1.5">
                <input id="teamSizeSlider" type="range" min="0" max="1000" value="20" autocomplete="off" class="cc-range w-full" aria-label="Team size slider (1 to 25,000 developers)" />
                <div class="flex justify-between text-[10px] font-mono text-[#525252] px-0.5 select-none">
                  <span>1</span>
                  <span>50</span>
                  <span>500</span>
                  <span>5k</span>
                  <span>25k</span>
                </div>
              </div>
              <div class="cc-team-input-shell">
                <button type="button" id="teamSizeDecBtn" class="cc-team-step-btn" aria-label="Decrease team size" title="Decrease by 1 dev">&minus;</button>
                <label for="teamSizeInput" class="cc-team-input-field">
                  <input id="teamSizeInput" type="number" min="1" max="100000" value="5" autocomplete="off" class="cc-team-input" aria-label="Number of developers" />
                  <span class="cc-team-input-unit">devs</span>
                </label>
                <button type="button" id="teamSizeIncBtn" class="cc-team-step-btn" aria-label="Increase team size" title="Increase by 1 dev">&#43;</button>
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4">
              <button type="button" data-team-preset="1" class="cc-team-card">
                <div class="cc-team-card-top"><span>Solo</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">1 <small>dev</small></div>
              </button>
              <button type="button" data-team-preset="10" class="cc-team-card">
                <div class="cc-team-card-top"><span>Startup</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">10 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="50" class="cc-team-card">
                <div class="cc-team-card-top"><span>Scaleup</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">50 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="250" class="cc-team-card">
                <div class="cc-team-card-top"><span>Mid-Market</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">250 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="1000" class="cc-team-card">
                <div class="cc-team-card-top"><span>Enterprise</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">1,000 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="5000" class="cc-team-card">
                <div class="cc-team-card-top"><span>Global Org</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">5,000 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="10000" class="cc-team-card">
                <div class="cc-team-card-top"><span>Big Tech</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">10,000 <small>devs</small></div>
              </button>
              <button type="button" data-team-preset="25000" class="cc-team-card">
                <div class="cc-team-card-top"><span>Hyperscale</span><i class="cc-team-dot"></i></div>
                <div class="cc-team-card-val">25,000 <small>devs</small></div>
              </button>
            </div>

            <!-- Enterprise / Negotiated Volume Discount (0% default) -->
            <div class="mt-4 pt-3.5 border-t border-[#1d1d1c] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-medium text-[#f4f4f2]">Negotiated / Commit Discount</span>
                  <span id="discountVal" class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#211c16] border border-[#4c4030] text-[#e2c48a] tabular-nums">0% (List Price)</span>
                </div>
                <p class="text-[11px] text-[#737373] mt-0.5">Enterprise EA / committed-spend discount across seat licenses &amp; LLM API rates.</p>
              </div>
              <div class="w-full sm:w-44 shrink-0 flex flex-col gap-1">
                <input id="discountSlider" type="range" min="0" max="50" step="1" value="0" autocomplete="off" class="cc-range w-full" aria-label="Negotiated volume discount percentage" />
                <div class="flex justify-between text-[9px] font-mono text-[#525252] px-0.5 select-none">
                  <span>0%</span>
                  <span>15%</span>
                  <span>30%</span>
                  <span>50%</span>
                </div>
              </div>
            </div>
          </section>

          <!-- 2. Seat Subscriptions -->
          <section class="cc-panel">
            <div class="cc-label mb-0.5">02 · Paid Seat Subscriptions</div>
            <p class="text-xs text-[#737373] mb-3.5">Select the AI IDEs, plugins, and code review subscriptions your team pays for per seat.</p>

            <!-- Quick popular chips -->
            <div id="popularToolChips" class="flex flex-wrap gap-1.5 mb-3.5"></div>

            <!-- Search box -->
            <div class="relative mb-3.5">
              <input
                id="toolSearchInput"
                type="search"
                placeholder="Search 100+ paid tools (Cursor, Copilot…)"
                autocomplete="off"
                class="w-full bg-[#111] border border-[#2a2a2a] hover:border-[#383838] focus:border-[#c8a96a] rounded-lg px-3.5 py-2.5 text-xs text-[#f5f2eb] placeholder-[#737373] focus:outline-none font-mono transition-colors"
              />
              <div id="toolSearchResults" style="display:none" class="absolute z-20 left-0 right-0 mt-1.5 bg-[#0f0f0f] border border-[#2c2c2b] rounded-xl shadow-2xl max-h-60 overflow-y-auto"></div>
            </div>

            <!-- Selected tools -->
            <div id="selectedSeatsList" class="flex flex-col gap-2"></div>
          </section>

          <!-- 3. BYOK / API Token Usage (models.dev) -->
          <section class="cc-panel">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
              <div>
                <div class="cc-label">03 · BYOK / API Token Workload (models.dev)</div>
                <p class="text-xs text-[#737373] mt-0.5">Estimate metered LLM API spend for CLI agents (Claude Code, Aider, Cline, OpenCode).</p>
              </div>
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span id="modelsCacheBadge" class="text-[11px] font-mono text-[#8b8b88]">Loading models.dev…</span>
                <button id="refreshModelsBtn" type="button" class="text-[11px] font-mono text-[#e2c48a] hover:text-[#fff4de] underline underline-offset-2 cursor-pointer transition-colors">Refresh</button>
              </div>
            </div>

            <!-- Workload Presets -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mb-4">
              <button type="button" data-workload="light" class="cc-workload-btn">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-semibold text-[#f4f4f2]">Light Assist</span>
                  <i class="cc-team-dot"></i>
                </div>
                <div class="text-[10px] font-mono text-[#8b8b88] mt-1">0.25M in / 0.05M out · day</div>
              </button>
              <button type="button" data-workload="daily" class="cc-workload-btn active">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-semibold text-[#f4f4f2]">Daily Driver</span>
                  <i class="cc-team-dot"></i>
                </div>
                <div class="text-[10px] font-mono text-[#8b8b88] mt-1">1.0M in / 0.20M out · day</div>
              </button>
              <button type="button" data-workload="agentic" class="cc-workload-btn">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-semibold text-[#f4f4f2]">Heavy Agentic</span>
                  <i class="cc-team-dot"></i>
                </div>
                <div class="text-[10px] font-mono text-[#8b8b88] mt-1">3.5M in / 0.60M out · day</div>
              </button>
            </div>

            <!-- Custom Sliders -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 p-3.5 rounded-xl bg-[#0d0d0d] border border-[#1d1d1c] mb-4">
              <div>
                <div class="flex justify-between text-[11px] font-mono mb-1.5">
                  <span class="text-[#8b8b88]">Input / dev</span>
                  <span id="inputTokensVal" class="text-[#e2c48a] tabular-nums">1.00M / day</span>
                </div>
                <input id="inputTokensSlider" type="range" min="0" max="10" step="0.25" value="1" autocomplete="off" class="cc-range w-full" />
              </div>
              <div>
                <div class="flex justify-between text-[11px] font-mono mb-1.5">
                  <span class="text-[#8b8b88]">Output / dev</span>
                  <span id="outputTokensVal" class="text-[#e2c48a] tabular-nums">0.20M / day</span>
                </div>
                <input id="outputTokensSlider" type="range" min="0" max="3" step="0.05" value="0.2" autocomplete="off" class="cc-range w-full" />
              </div>
              <div>
                <div class="flex justify-between text-[11px] font-mono mb-1.5">
                  <span class="text-[#8b8b88]">Prompt Cache Hit</span>
                  <span id="cacheHitVal" class="text-[#e2c48a] tabular-nums">65%</span>
                </div>
                <input id="cacheHitSlider" type="range" min="0" max="90" step="5" value="65" autocomplete="off" class="cc-range w-full" />
              </div>
            </div>

            <!-- Provider filter tabs -->
            <div id="providerTabs" class="flex flex-wrap gap-1.5 mb-3"></div>

            <!-- Model cards grid -->
            <div id="modelPickerGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-64 overflow-y-auto pr-1"></div>
          </section>
        </div>

        <!-- Right Sticky Summary & Savings (5 cols) -->
        <aside class="lg:col-span-5 lg:sticky lg:top-6 flex flex-col gap-5">
          <section class="cc-panel cc-panel-featured">
            <div class="cc-label text-[#d6b77a]">Estimated Team Spend</div>
            <div class="flex items-baseline gap-2.5 mt-1.5">
              <span id="totalPrimaryValue" class="text-4xl md:text-5xl font-medium tracking-tight font-mono text-[#f4f4f2]">$0</span>
              <span id="totalPrimaryUnit" class="text-sm font-mono text-[#8b8b88]">/ month</span>
            </div>
            <div id="totalSecondaryValue" class="text-xs font-mono text-[#e2c48a] mt-1">$0/yr projected</div>
            <div id="discountSavingsBadge" style="display:none" class="mt-2.5 px-3 py-1.5 rounded-lg bg-[#211c16] border border-[#4c4030] text-[11px] font-mono text-[#e2c48a]"></div>

            <!-- KPIs -->
            <div class="grid grid-cols-3 gap-3 mt-5 pt-4 border-t border-[#1d1d1c]">
              <div>
                <div class="text-[10px] font-mono uppercase tracking-wider text-[#8b8b88]">Per Developer</div>
                <div id="perDevValue" class="text-sm font-mono font-semibold text-[#f4f4f2] mt-0.5">$0/mo</div>
              </div>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-wider text-[#d6b77a]">Seat Licenses</div>
                <div id="seatTotalValue" class="text-sm font-mono font-semibold text-[#f4f4f2] mt-0.5">$0/mo</div>
              </div>
              <div>
                <div class="text-[10px] font-mono uppercase tracking-wider text-[#a3a3a3]">API Tokens</div>
                <div id="apiTotalValue" class="text-sm font-mono font-semibold text-[#f4f4f2] mt-0.5">$0/mo</div>
              </div>
            </div>

            <!-- Split progress bar -->
            <div class="h-1.5 w-full rounded-full bg-[#1a1a1a] overflow-hidden flex mt-3.5">
              <div id="seatBarFill" class="h-full bg-[#d6b77a] transition-all duration-300" style="width: 50%"></div>
              <div id="apiBarFill" class="h-full bg-[#737373] transition-all duration-300" style="width: 50%"></div>
            </div>

            <!-- Itemized Breakdown -->
            <div class="mt-5 pt-4 border-t border-[#1d1d1c]">
              <div class="cc-label mb-2">Itemized Stack Breakdown</div>
              <div id="lineItemsList" class="flex flex-col"></div>
            </div>
          </section>

          <!-- Cheaper Alternatives & Savings -->
          <section class="cc-panel">
            <div class="cc-label mb-0.5">Cheaper Alternatives & Optimizations</div>
            <p class="text-xs text-[#737373] mb-3.5">Lower-cost tools in the same category, open-source BYOK swaps, and model routing savings.</p>
            <div id="alternativesList" class="flex flex-col gap-2.5"></div>
          </section>
        </aside>
      </div>
    </div>
  </main>
</DashboardLayout>

<style is:inline>
  .cc-panel { background: rgba(255, 255, 255, 0.02); border: 1px solid #222; border-radius: 14px; padding: 20px; }
  .cc-panel-featured { background: linear-gradient(180deg, rgba(33, 28, 22, 0.42) 0%, rgba(10, 10, 10, 0.9) 100%); border-color: #4c4030; font-variant-numeric: tabular-nums; }
  .cc-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: #a3a3a3; font-weight: 600; }
  .cc-action-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; font-size: 12px; font-family: 'JetBrains Mono', monospace; color: #dcdcd9; background: #111; border: 1px solid #2c2c2b; cursor: pointer; transition: all 0.2s; }
  .cc-action-btn:hover { color: #fff; border-color: #4c4030; background: #191612; }
  .cc-action-btn-primary { background: #f4f4f2; color: #000; border-color: #f4f4f2; font-weight: 500; }
  .cc-action-btn-primary:hover { background: #fff; color: #000; border-color: #fff; }
  .cc-cycle-btn { padding: 5px 11px; font-size: 11px; font-family: 'JetBrains Mono', monospace; border-radius: 6px; color: #737373; border: 1px solid transparent; cursor: pointer; transition: background-color 0.15s, color 0.15s, border-color 0.15s; }
  .cc-cycle-btn.active { background: #211c16; color: #fff4de; border-color: #4c4030; }
  .cc-range { -webkit-appearance: none; appearance: none; height: 6px; border-radius: 999px; background: #1a1a1a; border: 1px solid #2a2a2a; outline: none; cursor: pointer; }
  .cc-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #e2c48a; border: 2px solid #0a0a0a; box-shadow: 0 0 0 1px #c8a96a, 0 2px 6px rgba(0,0,0,0.6); cursor: grab; transition: transform 0.15s, background-color 0.15s; }
  .cc-range::-webkit-slider-thumb:hover { transform: scale(1.1); background: #fff4de; }
  .cc-range::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #e2c48a; border: 2px solid #0a0a0a; box-shadow: 0 0 0 1px #c8a96a; cursor: grab; }
  .cc-team-input-shell { display: inline-flex; align-items: center; gap: 4px; padding: 4px; border-radius: 12px; background: linear-gradient(180deg, #16130f 0%, #0d0c0a 100%); border: 1px solid #352d22; box-shadow: inset 0 1px 0 rgba(255, 244, 222, 0.06), 0 4px 12px rgba(0, 0, 0, 0.35); flex-shrink: 0; transition: border-color 0.18s, box-shadow 0.18s; }
  .cc-team-input-shell:hover { border-color: #4c4030; }
  .cc-team-input-shell:focus-within { border-color: #c8a96a; box-shadow: inset 0 1px 0 rgba(255, 244, 222, 0.12), 0 0 0 3px rgba(200, 169, 106, 0.14); }
  .cc-team-input-field { display: inline-flex; align-items: baseline; gap: 6px; padding: 4px 8px; cursor: text; }
  .cc-team-input { width: 68px; background: transparent; border: none; outline: none; color: #fff4de; font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; -moz-appearance: textfield; appearance: textfield; }
  .cc-team-input::-webkit-outer-spin-button, .cc-team-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cc-team-input-unit { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: #c8a96a; user-select: none; }
  .cc-team-step-btn { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: rgba(255, 255, 255, 0.03); border: 1px solid #26221c; color: #a3a3a3; font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 600; line-height: 1; cursor: pointer; user-select: none; transition: background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.1s; }
  .cc-team-step-btn:hover { background: #262018; border-color: #c8a96a; color: #fff4de; }
  .cc-team-step-btn:active { transform: scale(0.95); }
  .cc-team-card { display: flex; flex-direction: column; justify-content: space-between; gap: 4px; padding: 9px 11px; border-radius: 10px; background: linear-gradient(180deg, rgba(255,255,255,0.025) 0%, rgba(255,255,255,0.008) 100%); border: 1px solid #222; text-align: left; cursor: pointer; transition: border-color 0.18s, background 0.18s, transform 0.18s, box-shadow 0.18s; font-variant-numeric: tabular-nums; }
  .cc-team-card:hover { border-color: #3d3529; background: linear-gradient(180deg, rgba(214,183,122,0.06) 0%, rgba(255,255,255,0.015) 100%); transform: translateY(-1px); }
  .cc-team-card.active { background: linear-gradient(180deg, #262018 0%, #17130e 100%); border-color: #c8a96a; box-shadow: inset 0 1px 0 rgba(255,244,222,0.12), 0 0 0 3px rgba(200,169,106,0.1); }
