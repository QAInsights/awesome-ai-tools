---
/**
 * Alternatives page - /tools/[slug]/alternatives
 *
 * Generated only for the ~20 most-compared tools (see getTopComparedTools) -
 * these map to high-intent "X alternatives" queries. Alternatives are the
 * other tools in the same category, enriched entries first. Fully
 * pre-rendered at build time so search engines and AI crawlers get the
 * complete list in the initial HTML.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { formatDate, getAlternativesFor, getCategorySlug, maxLastUpdated, type Tool } from '../../../lib/tools';
import { getComparisonsForTool, getTopComparedTools, hasAlternativesPage, humanizePricing } from '../../../lib/compare';

export async function getStaticPaths() {
    return getTopComparedTools().map(tool => ({
        params: { slug: tool.slug },
        props: { tool },
    }));
}

interface Props {
    tool: Tool;
}

const { tool } = Astro.props;
const { enriched } = tool;

const displayName = enriched?.name ?? tool.name;
const displayCompany = enriched?.company ?? tool.company;

const alternatives = getAlternativesFor(tool);
const count = alternatives.length;

// Curated comparison pages between this tool and each alternative
const pairByOtherSlug = new Map(
    getComparisonsForTool(tool.slug).map(c => [c.a === tool.slug ? c.b : c.a, c.slug])
);

const KNOWN_FREE = new Set(['free', 'open-source', 'open_source', 'oss']);
const freeAlts = alternatives.filter(t => KNOWN_FREE.has((t.enriched?.pricing ?? '').toLowerCase()));
const enrichedAlts = alternatives.filter(t => t.enriched);
const topNames = (enrichedAlts.length > 0 ? enrichedAlts : alternatives).slice(0, 3).map(t => t.enriched?.name ?? t.name);

// Honest freshness: latest enrichment stamp across this tool + its alternatives
const lastUpdated = maxLastUpdated([tool, ...alternatives].map(t => t.enriched?.lastUpdated));

const pageUrl = `https://ai.dosa.dev/tools/${tool.slug}/alternatives`;
const descMeta = `The best ${displayName} alternatives in 2026: ${count} ${tool.categoryShort} tools compared with pricing, key features, and verdicts - including ${topNames.join(', ')}.`;

// ── FAQ (AEO) - derived strictly from enriched data ─────────────────────────
const faqs: { q: string; a: string }[] = [
    {
        q: `What are the best alternatives to ${displayName}?`,
        a: `The closest ${displayName} alternatives on ai.dosa.dev are ${topNames.join(', ')} - all listed under ${tool.categoryClean}. Each has a detail page with pricing, key features, and a verdict.`,
    },
];
if (freeAlts.length > 0) {
    faqs.push({
        q: `Is there a free alternative to ${displayName}?`,
        a: `Yes - ${freeAlts.slice(0, 4).map(t => t.enriched?.name ?? t.name).join(', ')} ${freeAlts.length > 1 ? 'are' : 'is'} free or open source. ${freeAlts.length} of the ${count} alternatives listed here are free or open source.`,
    });
} else {
    faqs.push({
        q: `Is there a free alternative to ${displayName}?`,
        a: `None of the ${count} ${tool.categoryClean} alternatives listed here are confirmed free or open source - most offer free tiers or trials. Check each tool's detail page for current pricing.`,
    });
}
faqs.push({
    q: `How were these ${displayName} alternatives chosen?`,
    a: `Alternatives are the other tools in the ${tool.categoryClean} category of ai.dosa.dev's manually curated directory, ordered with fully reviewed (enriched) entries first. Entries are enriched with pricing, features, and reviewer notes and updated continuously.`,
});

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "CollectionPage",
            "@id": `${pageUrl}#collection`,
            "url": pageUrl,
            "name": `Best ${displayName} Alternatives`,
            "description": descMeta,
            "inLanguage": "en",
            ...(lastUpdated ? { "dateModified": lastUpdated } : {}),
            "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
            "about": { "@type": "SoftwareApplication", "name": displayName, "url": `https://ai.dosa.dev/tools/${tool.slug}` },
        },
        {
            "@type": "ItemList",
            "name": `${displayName} alternatives`,
            "numberOfItems": count,
            "itemListElement": alternatives.map((t, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "name": t.enriched?.name ?? t.name,
                "url": `https://ai.dosa.dev/tools/${t.slug}`
            }))
        },
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map(f => ({
                "@type": "Question",
                "name": f.q,
                "acceptedAnswer": { "@type": "Answer", "text": f.a }
            }))
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
                { "@type": "ListItem", "position": 2, "name": tool.categoryClean, "item": `https://ai.dosa.dev/category/${getCategorySlug(tool.categoryShort)}` },
                { "@type": "ListItem", "position": 3, "name": displayName, "item": `https://ai.dosa.dev/tools/${tool.slug}` },
                { "@type": "ListItem", "position": 4, "name": "Alternatives", "item": pageUrl }
            ]
        }
    ]
});

// Sibling alternatives pages in the same category (crawl depth)
const siblingAltPages = getTopComparedTools()
    .filter(t => t.slug !== tool.slug && t.category === tool.category)
    .slice(0, 6);
---

<BaseLayout
    title={`${count} Best ${displayName} Alternatives (2026) - Compared | ai.dosa.dev`}
    description={descMeta}
    keywords={`${displayName} alternatives, ${displayName} competitors, tools like ${displayName}, ${tool.categoryClean}, best ${tool.categoryShort} tools`}
    canonical={pageUrl}
    jsonLd={jsonLd}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" title={`${displayName} alternatives`} />

            <div class="max-w-[1000px] mx-auto w-full flex flex-col flex-1 p-4 md:p-8 gap-6">
                <!-- Breadcrumb -->
                <nav aria-label="Breadcrumb" class="font-mono text-[12px] text-[#737373] tracking-wide flex items-center gap-2 flex-wrap">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <span>/</span>
                    <a href={`/category/${getCategorySlug(tool.categoryShort)}`} class="text-[#a3a3a3] hover:text-white transition-colors">{tool.categoryClean}</a>
                    <span>/</span>
                    <a href={`/tools/${tool.slug}`} class="text-[#a3a3a3] hover:text-white transition-colors">{displayName}</a>
                    <span>/</span>
                    <span class="text-white">Alternatives</span>
                </nav>

                <!-- Header -->
                <header class="flex flex-col gap-3 pb-4 border-b border-[#222]">
                    <h1 class="text-[32px] md:text-[40px] font-semibold tracking-tight leading-tight bg-gradient-to-r from-white via-[#e5e5e5] to-white bg-clip-text text-transparent">
                        Best {displayName} Alternatives
                    </h1>
                    <p class="text-[17px] leading-relaxed text-[#d4d4d4] max-w-[72ch]">
                        {displayName} by {displayCompany} is listed under {tool.categoryClean}. If you're weighing options, these are the {count} closest alternatives in the directory - with pricing, key features, and verdicts on each detail page.
                    </p>
                    <div class="font-mono text-[12px] text-[#737373] tracking-wide">
                        {count} alternatives{freeAlts.length > 0 && ` · ${freeAlts.length} free or open source`}{lastUpdated && <> · Updated <time datetime={lastUpdated}>{formatDate(lastUpdated)}</time></>}
                    </div>
                </header>

                <!-- Alternatives list (pre-rendered, no JS required) -->
                <section aria-label={`${displayName} alternatives`} class="flex flex-col">
                    {alternatives.map(alt => {
                        const altName = alt.enriched?.name ?? alt.name;
                        const pairSlug = pairByOtherSlug.get(alt.slug);
                        return (
                            <div class="group flex flex-col gap-1.5 py-4 border-b border-[#1a1a1a] transition-colors hover:bg-white/[0.02] md:px-2 -mx-2 rounded">
                                <div class="flex items-center gap-3 flex-wrap">
                                    <a href={`/tools/${alt.slug}`} class="text-[16px] font-medium text-white no-underline group-hover:bg-gradient-to-r group-hover:from-[#a78bfa] group-hover:via-[#22d3ee] group-hover:to-[#a78bfa] group-hover:bg-clip-text group-hover:text-transparent transition-all">{altName}</a>
                                    <span class="font-mono text-[12px] text-[#737373] uppercase tracking-wide">{alt.enriched?.company ?? alt.company}</span>
                                    {alt.enriched?.pricing && (
                                        <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-0.5 border border-[#222] rounded-full text-[#737373]">{humanizePricing(alt.enriched.pricing)}</span>
                                    )}
                                </div>
                                <p class="text-[14px] text-[#a3a3a3] leading-relaxed line-clamp-2 m-0">{alt.enriched?.description ?? alt.notes}</p>
                                <div class="flex items-center gap-4 mt-0.5">
                                    <a href={`/tools/${alt.slug}`} class="font-mono text-[12px] text-[#a3a3a3] hover:text-white tracking-wide transition-colors">Details &rarr;</a>
                                    {pairSlug && (
                                        <a href={`/compare/${pairSlug}`} class="font-mono text-[12px] text-[#c9aa6e] hover:text-[#e2c48a] tracking-wide transition-colors">{displayName} vs {altName} &rarr;</a>
                                    )}
                                    {hasAlternativesPage(alt.slug) && (
                                        <a href={`/tools/${alt.slug}/alternatives`} class="font-mono text-[12px] text-[#525252] hover:text-white tracking-wide transition-colors">{altName} alternatives &rarr;</a>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </section>

                <!-- FAQ (AEO: mirrors FAQPage JSON-LD) -->
                <section aria-label="Frequently asked questions" class="flex flex-col gap-4 pt-4">
                    <div class="font-mono text-[11px] uppercase text-[#525252] tracking-[0.2em]">FAQ</div>
                    {faqs.map(f => (
                        <details class="border border-[#222] bg-white/[0.02] rounded-md group">
                            <summary class="cursor-pointer px-5 py-4 text-[15px] font-medium text-white list-none flex items-center justify-between gap-3 hover:bg-white/[0.03] transition-colors rounded-md">
                                {f.q}
                                <svg class="w-4 h-4 text-[#525252] shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </summary>
                            <p class="px-5 pb-4 pt-1 text-[14px] text-[#a3a3a3] leading-relaxed">{f.a}</p>
                        </details>
                    ))}
                </section>

                <!-- Cross-links: back to tool, category, sibling alternatives pages -->
                <nav aria-label="Explore more" class="pt-4 pb-8 flex flex-col gap-4">
                    <div class="font-mono text-[11px] uppercase text-[#525252] tracking-[0.2em]">Explore more</div>
                    <div class="flex flex-wrap gap-2">
                        <a href={`/tools/${tool.slug}`} class="inline-flex items-center gap-2 px-3 py-1.5 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide hover:text-white hover:border-[#444] transition-colors">
                            {displayName} review
                        </a>
                        <a href={`/category/${getCategorySlug(tool.categoryShort)}`} class="inline-flex items-center gap-2 px-3 py-1.5 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide hover:text-white hover:border-[#444] transition-colors">
                            All {tool.categoryShort} tools
                        </a>
                        {siblingAltPages.map(t => (
                            <a href={`/tools/${t.slug}/alternatives`} class="inline-flex items-center gap-2 px-3 py-1.5 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide hover:text-white hover:border-[#444] transition-colors">
                                {t.enriched?.name ?? t.name} alternatives
                            </a>
                        ))}
                    </div>
                </nav>
            </div>
        </main>
    </div>

    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
