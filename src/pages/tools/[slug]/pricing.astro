---
/**
 * Pricing page - /tools/[slug]/pricing
 *
 * Generated only for the ~30 most-compared tools that have enriched pricing
 * data (see getTopPricingTools) - these map to high-intent "X pricing" and
 * "is X free" queries. Fully pre-rendered at build time so search engines
 * and AI crawlers get the complete content in the initial HTML.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import FolioStyles from '../../../components/folio/FolioStyles.astro';
import FolioTitle from '../../../components/folio/FolioTitle.astro';
import FolioPlans from '../../../components/folio/FolioPlans.astro';
import FolioFaq from '../../../components/folio/FolioFaq.astro';
import FolioScroll from '../../../components/folio/FolioScroll.astro';
import { entryLabel, priceSummary } from '../../../lib/folio';
import { addOutboundUtmParams } from '../../../lib/outbound-utm.js';
import { formatDate, getAlternativesFor, getCategorySlug, type Tool } from '../../../lib/tools';
import { robotsFor } from '../../../lib/indexing';
import { getTopPricingTools, hasAlternativesPage, humanizePricing, truncate } from '../../../lib/compare';
import { buildToolFaqs, isKnownFree, isOpenSource } from '../../../lib/tool-faqs';

export async function getStaticPaths() {
    return getTopPricingTools().map(tool => ({
        params: { slug: tool.slug },
        props: { tool },
    }));
}

interface Props {
    tool: Tool;
}

const { tool } = Astro.props;
const { enriched } = tool;

const displayName = enriched?.name ?? tool.name;
const displayCompany = enriched?.company ?? tool.company;
const pricingLabel = humanizePricing(enriched?.pricing);
const freeTier = enriched?.pricing?.toLowerCase() === 'freemium' ? 'Free tier' : (isKnownFree(enriched?.pricing) ? 'Yes' : 'No');
const openSource = isOpenSource(enriched) ? 'Yes' : 'No';
const lastUpdated = enriched?.lastUpdated;

const alternatives = getAlternativesFor(tool).slice(0, 8);
const faqs = buildToolFaqs(tool, getAlternativesFor(tool));

const pageUrl = `https://ai.dosa.dev/tools/${tool.slug}/pricing`;
const toolUrl = `https://ai.dosa.dev/tools/${tool.slug}`;
const descMeta = truncate(`${displayName} pricing (${pricingLabel}). ${enriched?.pricingDetail ?? `Is ${displayName} free? Plans, free tier, and alternatives on ai.dosa.dev.`}`, 155);
const title = `${displayName} Pricing (2026): Is ${displayName} Free? | ai.dosa.dev`;

const graph: object[] = [
    {
        "@type": "WebPage",
        "@id": pageUrl,
        "url": pageUrl,
        "name": title,
        "description": descMeta,
        "inLanguage": "en",
        ...(lastUpdated ? { "dateModified": lastUpdated } : {}),
        "isPartOf": { "@type": "WebSite", "@id": "https://ai.dosa.dev/#website", "url": "https://ai.dosa.dev", "name": "ai.dosa.dev - Awesome AI Tools" },
        "about": { "@id": `${toolUrl}#app` },
    },
    {
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
            { "@type": "ListItem", "position": 2, "name": tool.categoryClean, "item": `https://ai.dosa.dev/category/${getCategorySlug(tool.categoryShort)}` },
            { "@type": "ListItem", "position": 3, "name": displayName, "item": toolUrl },
            { "@type": "ListItem", "position": 4, "name": "Pricing", "item": pageUrl }
        ]
    }
];
if (faqs.length >= 2) {
    graph.push({
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({
            "@type": "Question",
            "name": f.q,
            "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
    });
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

const price = priceSummary(enriched?.pricing, enriched?.pricingDetail);
const hasSiteLink = typeof tool.url === 'string' && /^https?:\/\//i.test(tool.url);
const siteHref = hasSiteLink ? addOutboundUtmParams(tool.url) : '';
const updated = lastUpdated ? formatDate(lastUpdated) : null;
const showAlternativesLink = hasAlternativesPage(tool.slug);
const facts = [
    { k: 'Pricing model', v: pricingLabel },
    { k: 'Free tier', v: freeTier === 'No' ? 'No' : 'Yes' },
    { k: 'Open source', v: openSource },
    { k: 'Paid plans', v: price.paid.length ? String(price.paid.length) : 'None listed' },
];
const hasFit = Boolean(enriched?.bestFor || enriched?.notIdealFor);
const sections = [
    'plans',
    hasFit && 'fit',
    alternatives.length && 'alternatives',
    faqs.length >= 2 && 'faq',
    'more',
].filter(Boolean) as string[];
const num = (id: string) => String(sections.indexOf(id) + 1).padStart(2, '0');

---

<BaseLayout
    title={title}
    description={descMeta}
    keywords={`${displayName} pricing, is ${displayName} free, ${displayName} cost, ${displayName} free tier, ${displayName} open source, ${tool.categoryClean}`}
    canonical={pageUrl}
    robots={robotsFor(`/tools/${tool.slug}/pricing`)}
    jsonLd={jsonLd}
>
    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <SiteHeader variant="page" title={`${displayName} pricing`} />

            <article class="fo">
                <header class="fo-hero">
                    <div>
                        <div class="fo-top fo-fade" style="--d:.1s">
                            <nav aria-label="Breadcrumb" class="fo-crumbs">
                                <a href="/">Home</a><span>/</span>
                                <a href={`/category/${getCategorySlug(tool.categoryShort)}`}>{tool.categoryClean}</a><span>/</span>
                                <a href={`/tools/${tool.slug}`}>{displayName}</a><span>/</span>
                                <span class="here">Pricing</span>
                            </nav>
                            {updated && <span class="fo-status"><span>Updated <time datetime={lastUpdated}>{updated}</time></span></span>}
                        </div>
                        <div class="fo-rule"></div>
                    </div>
                    <div>
                        <FolioTitle parts={[{ text: displayName }, { text: 'Pricing', plain: true }]} size="lg" />
                        <div class="fo-intro">
                            <p class="fo-lead fo-fade" style="--d:.55s">
                                {displayName} by {displayCompany} is listed as {pricingLabel} under {tool.categoryClean} on ai.dosa.dev. See the <a class="fo-link" href={`/tools/${tool.slug}`}>{displayName} review</a> for features and verdict.
                            </p>
                            <div class="fo-price fo-fade" style="--d:.7s">
                                <small>{price.entry ? 'From' : 'Pricing'}</small>
                                <b>{price.main}</b>
                                <span>{price.unit}{price.entry && price.freeTier ? ' · free tier available' : ''}</span>
                            </div>
                            <div class="fo-cta fo-fade" style="--d:.85s">
                                {hasSiteLink && <a class="fo-btn" href={siteHref} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${displayName} website`}>Visit site <i aria-hidden="true">→</i></a>}
                                <a class="fo-link" href={`/tools/${tool.slug}`}>Full {displayName} review</a>
                            </div>
                        </div>
                        <section class="fo-facts" aria-label="Pricing summary">
                            {facts.map((f, i) => (
                                <div class="fo-fact fo-fade" style={`--d:${0.9 + i * 0.08}s`}>
                                    <span class="fo-k">{f.k}</span>
                                    <b>{f.v}</b>
                                </div>
                            ))}
                        </section>
                    </div>
                </header>

                <section class="fo-sec" id="plans">
                    <h2 class="fo-label"><em>{num('plans')}</em>Plans</h2>
                    <div class="fo-body">
                        <FolioPlans pricing={enriched?.pricing} detail={enriched?.pricingDetail} footnote="Pricing changes often - verify on the official site." />
                    </div>
                </section>

                {hasFit && (
                    <section class="fo-sec" id="fit">
                        <h2 class="fo-label"><em>{num('fit')}</em>Who it's for</h2>
                        <div class="fo-body fo-fit">
                            {enriched?.bestFor && <div class="fo-reveal"><h3>Best for</h3><p>{enriched.bestFor}</p></div>}
                            {enriched?.notIdealFor && <div class="fo-reveal"><h3>Not ideal for</h3><p>{enriched.notIdealFor}</p></div>}
                        </div>
                    </section>
                )}

                {alternatives.length > 0 && (
                    <section class="fo-sec" id="alternatives" aria-label={`${displayName} alternatives and their pricing`}>
                        <h2 class="fo-label"><em>{num('alternatives')}</em>Alternatives and their pricing</h2>
                        <div class="fo-body">
                            {alternatives.map(alt => (
                                <a class="fo-alt" href={`/tools/${alt.slug}`}>
                                    <span><b>{alt.enriched?.name ?? alt.name}</b></span>
                                    <small>{alt.enriched?.company ?? alt.company}</small>
                                    <span class="pr">{entryLabel(alt)}</span>
                                    <i aria-hidden="true">→</i>
                                </a>
                            ))}
                            {showAlternativesLink && (
                                <div class="fo-more"><a href={`/tools/${tool.slug}/alternatives`}>See all {displayName} alternatives →</a></div>
                            )}
                        </div>
                    </section>
                )}

                {faqs.length >= 2 && (
                    <section class="fo-sec" id="faq" aria-label="Frequently asked questions">
                        <h2 class="fo-label"><em>{num('faq')}</em>FAQ</h2>
                        <FolioFaq faqs={faqs} />
                    </section>
                )}

                <nav class="fo-sec" id="more" aria-label="Explore more">
                    <h2 class="fo-label"><em>{num('more')}</em>Explore more</h2>
                    <div class="fo-body">
                        <ul class="fo-tags">
                            <li><a href={`/tools/${tool.slug}`}>{displayName} review</a></li>
                            <li><a href={`/category/${getCategorySlug(tool.categoryShort)}`}>All {tool.categoryShort} tools</a></li>
                            {showAlternativesLink && <li><a href={`/tools/${tool.slug}/alternatives`}>{displayName} alternatives</a></li>}
                        </ul>
                    </div>
                </nav>

                {hasSiteLink && (
                    <footer class="fo-end">
                        <a class="big" href={siteHref} target="_blank" rel="noopener noreferrer">Try {displayName}<i aria-hidden="true">→</i></a>
                        <span class="fo-k" style="margin:0">{price.entry ? `From ${price.main} ${price.unit}` : price.main}</span>
                    </footer>
                )}

                <div class="fo-notes">
                    <span>Content on this page is AI-generated. Please verify details with the vendor's website for accuracy.</span>
                    <a class="back" href={`/tools/${tool.slug}`}>← Back to {displayName}</a>
                </div>
            </article>
        </main>
    </div>

    <FolioStyles />
    <FolioScroll />
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
