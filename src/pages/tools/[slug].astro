---
/**
 * Dynamic tool detail page - [slug].astro
 *
 * Replaces:
 *   - scripts/generate-tool-pages.js  (build-time page generator)
 *   - src/tool-template.html          (template)
 *   - js/shell.js                     (runtime sidebar injection)
 *   - js/tool-detail.js               (runtime data hydration)
 *   - js/tool-cache.js                (localStorage cache for enriched data)
 *
 * All 108 tool pages are now generated from this single file via getStaticPaths().
 * Seed + enriched data are embedded at build time - no client-side fetch needed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { formatDate, getAlternativesFor, getAllTools, getCategorySlug, getToolBySlug, type Tool } from '../../lib/tools';
import { getComparisonsForTool, hasAlternativesPage, humanizePricing, truncate } from '../../lib/compare';
import { addOutboundUtmParams } from '../../lib/outbound-utm.js';

export async function getStaticPaths() {
    const tools = getAllTools();
    return tools.map(tool => ({
        params: { slug: tool.slug },
        props: { tool },
    }));
}

interface Props {
    tool: Tool;
}

const { tool } = Astro.props;
const { enriched } = tool;

// Prefer enriched data, fall back to seed
const displayName = enriched?.name ?? tool.name;
const displayCompany = enriched?.company ?? tool.company;
const displayDescription = enriched?.description ?? tool.notes;

// Meta description (truncated to 155 chars)
const descMeta = truncate(displayDescription, 155);

const keywords = [
    tool.name,
    tool.company,
    tool.categoryClean,
    tool.categoryShort,
    'AI coding',
    'developer tools',
].filter(Boolean).join(', ');

// JSON-LD structured data
// Only emit a free Offer when pricing is actually known to be free -
// hardcoding price:0 for paid/freemium tools is misleading structured data.
const KNOWN_FREE = new Set(['free', 'open-source', 'open_source', 'oss']);
const isKnownFree = KNOWN_FREE.has((enriched?.pricing ?? '').toLowerCase());
const softwareApp: Record<string, unknown> = {
    "@type": "SoftwareApplication",
    "@id": `https://ai.dosa.dev/tools/${tool.slug}#app`,
    "name": displayName,
    "url": tool.url || `https://ai.dosa.dev/tools/${tool.slug}`,
    "description": displayDescription,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    // Honest freshness: dateModified reflects the enrichment pipeline's
    // lastUpdated stamp for this tool, not the build date.
    ...(enriched?.lastUpdated ? { "dateModified": enriched.lastUpdated } : {}),
    "isPartOf": {
        "@type": "WebSite",
        "@id": "https://ai.dosa.dev/#website",
        "url": "https://ai.dosa.dev",
        "name": "ai.dosa.dev - Awesome AI Tools"
    }
};
if (isKnownFree) {
    softwareApp["offers"] = { "@type": "Offer", "price": "0", "priceCurrency": "USD" };
}

const jsonLdObj = {
    "@context": "https://schema.org",
    "@graph": [
        softwareApp,
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ai.dosa.dev" },
                { "@type": "ListItem", "position": 2, "name": tool.categoryClean, "item": `https://ai.dosa.dev/category/${getCategorySlug(tool.categoryShort)}` },
                { "@type": "ListItem", "position": 3, "name": displayName, "item": `https://ai.dosa.dev/tools/${tool.slug}` }
            ]
        }
    ]
};

// ── Related tools (same category, enriched first) ───────────────────────────
const related = getAlternativesFor(tool).slice(0, 6);
const showAlternativesLink = hasAlternativesPage(tool.slug);

// ── Curated comparison pages featuring this tool ────────────────────────────
const comparisons = getComparisonsForTool(tool.slug)
    .map(c => {
        const a = getToolBySlug(c.a);
        const b = getToolBySlug(c.b);
        return a && b ? { slug: c.slug, label: `${a.name} vs ${b.name}` } : null;
    })
    .filter((c): c is { slug: string; label: string } => c !== null)
    .slice(0, 4);

// ── FAQ block (AEO) - built from enriched data, only where data exists ──────
const faqs: { q: string; a: string }[] = [];
if (enriched?.pricing) {
    const p = enriched.pricing.toLowerCase();
    const isFree = ['free', 'open-source', 'open_source', 'oss'].includes(p);
    faqs.push({
        q: `Is ${displayName} free?`,
        a: isFree
            ? `Yes - ${displayName} is ${humanizePricing(enriched.pricing)}.${enriched.pricingDetail ? ' ' + enriched.pricingDetail : ''}`
            : `${displayName} is ${humanizePricing(enriched.pricing)}.${enriched.pricingDetail ? ' ' + enriched.pricingDetail : ''} Check the official site for current plans.`,
    });
}
if (enriched?.bestFor) {
    faqs.push({ q: `What is ${displayName} best for?`, a: enriched.bestFor });
}
if (displayCompany) {
    faqs.push({
        q: `Who makes ${displayName}?`,
        a: `${displayName} is developed by ${displayCompany}. It is listed in the ${tool.categoryClean} category on ai.dosa.dev.`,
    });
}
if (faqs.length >= 2) {
    (jsonLdObj["@graph"] as object[]).push({
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({
            "@type": "Question",
            "name": f.q,
            "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
    });
}
const jsonLd = JSON.stringify(jsonLdObj);
---

<BaseLayout
    title={`${displayName} - ${displayCompany} | ai.dosa.dev`}
    description={descMeta}
    keywords={keywords}
    canonical={`https://ai.dosa.dev/tools/${tool.slug}`}
    ogTitle={`${displayName} - ${displayCompany} | ai.dosa.dev`}
    ogDescription={descMeta}
    ogImage={`https://ai.dosa.dev/images/og/${tool.slug}.png`}
    ogType="article"
    modifiedTime={enriched?.lastUpdated}
    twitterTitle={`${displayName} - ${displayCompany} | ai.dosa.dev`}
    twitterDescription={descMeta}
    jsonLd={jsonLd}
>
    <slot name="head">
        <style>
            .td-section { padding: 20px 0; border-top: 1px solid #222; }
            .td-section:first-of-type { border-top: none; }
            .td-section-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #525252; margin-bottom: 14px; }
            .td-card { background: #0d0d0d; border: 1px solid #222; border-radius: 10px; padding: 18px; transition: border-color 0.2s; }
            .td-card:hover { border-color: #333; }
            .td-verdict { border-left: 3px solid; border-image: linear-gradient(180deg, #a78bfa, #22d3ee) 1; padding: 14px 18px; background: linear-gradient(90deg, rgba(167,139,250,0.04), transparent); font-size: 16px; line-height: 1.7; color: #d4d4d4; font-style: italic; }
        </style>
    </slot>

    <div class="flex h-[100dvh] overflow-hidden">
        <Sidebar variant="tool" />

        <main class="flex-1 flex flex-col h-full bg-black min-w-0 relative overflow-y-auto">
            <!-- Mobile Header -->
            <div class="md:hidden flex items-center justify-between p-4 border-b border-[#222] bg-[#0a0a0a] shrink-0 z-10 sticky top-0">
                <div class="flex items-center gap-3">
                    <button id="openSidebarMobile" aria-label="Open sidebar menu" class="text-[#a3a3a3] hover:text-white transition-colors p-1 rounded-md hover:bg-white/5">
                        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    </button>
                    <div class="flex items-center gap-2 min-w-0">
                        <img src="/images/icons/favicon-32x32.png" alt="logo" class="w-6 h-6 rounded-full" />
                        <span class="text-[17px] font-semibold tracking-wide text-white leading-none truncate">{displayName}</span>
                    </div>
                </div>
            </div>

            <!-- Desktop Sidebar Toggle -->
            <div id="desktopToggleContainer" class="hidden absolute top-[14px] left-4 z-20 transition-opacity duration-300">
                <button id="openSidebarDesktop" aria-label="Open sidebar" class="text-[#a3a3a3] hover:text-white p-1.5 bg-[#0a0a0a] border border-[#222] rounded-md shadow-sm transition-all hover:bg-white/5 backdrop-blur-sm" title="Open sidebar">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                </button>
            </div>

            <div class="max-w-[1000px] mx-auto w-full flex flex-col flex-1 p-4 md:p-8 gap-6">
                <!-- Breadcrumb -->
                <nav aria-label="Breadcrumb" class="font-mono text-[12px] text-[#737373] tracking-wide flex items-center gap-2 flex-wrap">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <span>/</span>
                    <a href={`/category/${getCategorySlug(tool.categoryShort)}`} class="text-[#a3a3a3] hover:text-white transition-colors">{tool.categoryClean}</a>
                    <span>/</span>
                    <span class="text-white">{displayName}</span>
                </nav>

                <!-- Hero Header -->
                <header class="flex flex-col gap-4 pb-4 border-b border-[#222]">
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                        <div class="min-w-0">
                            <h1 class="text-[32px] md:text-[40px] font-semibold tracking-tight leading-tight bg-gradient-to-r from-white via-[#e5e5e5] to-white bg-clip-text text-transparent mb-2">
                                {displayName}
                            </h1>
                            <div class="flex items-center gap-3 flex-wrap">
                                <span class="font-mono text-[14px] text-[#a3a3a3] uppercase tracking-wide">{displayCompany}</span>
                                <span class="text-[#333]">·</span>
                                <span class="inline-block px-3 py-1 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide">{tool.categoryClean}</span>
                                {enriched?.lastUpdated && (
                                    <>
                                        <span class="text-[#333]">·</span>
                                        <span class="inline-flex items-center gap-1.5 font-mono text-[12px] text-[#a3a3a3] tracking-wide">
                                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#4ade80]" aria-hidden="true"></span>
                                            Updated <time datetime={enriched.lastUpdated}>{formatDate(enriched.lastUpdated)}</time>
                                        </span>
                                    </>
                                )}
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button class="favorite-btn detail" type="button" data-tool-slug={tool.slug} data-tool-name={displayName} aria-label={`Sign in to save ${displayName}`} aria-pressed="false" title={`Sign in to save ${displayName}`}>
                                <svg class="favorite-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-3.75L6 21V4.75Z"/>
                                </svg>
                                <span data-favorite-label>Favorite</span>
                            </button>
                            <button class="follow-btn detail" type="button" data-tool-slug={tool.slug} data-tool-name={displayName} aria-label={`Sign in to follow ${displayName}`} aria-pressed="false" title={`Get email updates about ${displayName}`}>
                                <svg class="follow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/>
                                </svg>
                                <span data-follow-label>Follow</span>
                            </button>
                            <a href={addOutboundUtmParams(tool.url)} target="_blank" rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 py-2.5 px-5 bg-white text-black text-sm font-semibold rounded-md transition-all duration-200 hover:bg-gray-200 hover:-translate-y-px shrink-0"
                                aria-label={`Visit ${displayName} website`}>
                                Visit site
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                            </a>
                        </div>
                    </div>
                    <p class="text-[17px] leading-relaxed text-[#d4d4d4] max-w-[72ch]">{displayDescription}</p>
                </header>

                <!-- Enriched Content Sections (build-time rendered) -->
                <div class="flex flex-col gap-6">

                    {enriched?.recentUpdates && (
                        <section class="td-section">
                            <div class="td-section-label">Recent Updates</div>
                            <div class="td-card">
                                <p class="text-[15px] leading-relaxed text-[#d4d4d4]">{enriched.recentUpdates}</p>
                                {enriched.lastUpdated && (
                                    <p class="font-mono text-[11px] text-[#525252] tracking-wide mt-3 mb-0">
                                        As of <time datetime={enriched.lastUpdated}>{formatDate(enriched.lastUpdated)}</time>
                                    </p>
                                )}
                            </div>
                        </section>
                    )}

                    {!enriched && (
                        <div class="td-card flex items-start gap-3 border-dashed">
                            <svg class="w-5 h-5 text-[#737373] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <div class="text-[14px] text-[#a3a3a3] leading-relaxed">
                                <div class="text-white font-medium mb-0.5">Enriched details coming soon</div>
                                We're still gathering pricing, key features, and reviewer notes for this tool. In the meantime, visit the official site for more.
                            </div>
                        </div>
                    )}

                    {enriched?.keyFeatures && enriched.keyFeatures.length > 0 && (
                        <section class="td-section">
                            <div class="td-section-label">Key Features</div>
                            <ul class="flex flex-col gap-3">
                                {enriched.keyFeatures.map(f => (
                                    <li class="flex items-start gap-3">
                                        <svg class="w-5 h-5 shrink-0 text-[#a78bfa] mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span class="text-[15px] leading-relaxed text-[#d4d4d4]">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )}

                    {(enriched?.bestFor || enriched?.notIdealFor) && (
                        <section class="td-section">
                            <div class="td-section-label">Who It's For</div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="td-card">
                                    <div class="font-mono text-[11px] uppercase text-[#4ade80] tracking-wide mb-2">&#10003; Best For</div>
                                    <p class="text-[15px] leading-relaxed text-[#d4d4d4]">{enriched.bestFor ?? '-'}</p>
                                </div>
                                <div class="td-card">
                                    <div class="font-mono text-[11px] uppercase text-[#f87171] tracking-wide mb-2">&#10007; Not Ideal For</div>
                                    <p class="text-[15px] leading-relaxed text-[#d4d4d4]">{enriched.notIdealFor ?? '-'}</p>
                                </div>
                            </div>
                        </section>
                    )}

                    {(enriched?.pricing || enriched?.pricingDetail) && (
                        <section class="td-section">
                            <div class="td-section-label">Pricing</div>
                            <div class="td-card">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="inline-block px-3 py-1 bg-[#a78bfa]/10 border border-[#a78bfa]/30 rounded-full font-mono text-[12px] text-[#c4b5fd] tracking-wide">
                                        {humanizePricing(enriched.pricing)}
                                    </span>
                                </div>
                                {enriched.pricingDetail && (
                                    <p class="text-[15px] leading-relaxed text-[#d4d4d4]">{enriched.pricingDetail}</p>
                                )}
                            </div>
                        </section>
                    )}

                    {enriched?.verdict && (
                        <section class="td-section">
                            <div class="td-section-label">Verdict</div>
                            <blockquote class="td-verdict">{enriched.verdict}</blockquote>
                        </section>
                    )}

                    {enriched?.tags && enriched.tags.length > 0 && (
                        <section class="td-section">
                            <div class="td-section-label">Tags</div>
                            <div class="flex flex-wrap gap-2">
                                {enriched.tags.map(tag => (
                                    <span class="inline-block px-3 py-1 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide">{tag}</span>
                                ))}
                            </div>
                        </section>
                    )}

                    {faqs.length >= 2 && (
                        <section class="td-section" aria-label="Frequently asked questions">
                            <div class="td-section-label">FAQ</div>
                            <div class="flex flex-col gap-3">
                                {faqs.map(f => (
                                    <details class="td-card group" style="padding: 0;">
                                        <summary class="cursor-pointer px-4 py-3.5 text-[15px] font-medium text-white list-none flex items-center justify-between gap-3">
                                            {f.q}
                                            <svg class="w-4 h-4 text-[#525252] shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </summary>
                                        <p class="px-4 pb-4 text-[14px] text-[#a3a3a3] leading-relaxed">{f.a}</p>
                                    </details>
                                ))}
                            </div>
                        </section>
                    )}

                    <!-- Conversion CTA: sign-in nudge (tool pages are the top entry pages) -->
                    <section class="td-section" aria-label="Track this tool" data-signed-out-only>
                        <div class="td-card flex flex-col sm:flex-row sm:items-center gap-4" style="background: linear-gradient(90deg, rgba(167,139,250,0.06), rgba(34,211,238,0.04)); border-color: #333;">
                            <div class="grow">
                                <div class="text-white font-medium text-[15px] mb-1">Track {displayName} in your AI stack</div>
                                <p class="text-[13px] text-[#a3a3a3] leading-relaxed m-0">Favorite this tool to revisit it later, or Zap it to contribute to the public vote count.</p>
                            </div>
                            <div class="flex items-center gap-2.5 shrink-0">
                                <a href={`/category/${getCategorySlug(tool.categoryShort)}`} class="inline-flex items-center py-2.5 px-4 bg-white/5 text-white text-sm font-medium border border-[#333] rounded-md transition-all hover:bg-white/10 whitespace-nowrap">
                                    Compare {tool.categoryShort}
                                </a>
                                <a href="/?signin=1" data-auth-trigger="favorite_heart" class="inline-flex items-center py-2.5 px-4 bg-white text-black text-sm font-semibold rounded-md transition-all hover:bg-gray-200 whitespace-nowrap">
                                    Sign in to save
                                </a>
                            </div>
                        </div>
                    </section>

                    {related.length > 0 && (
                        <section class="td-section" aria-label={`More ${tool.categoryClean} tools`}>
                            <div class="td-section-label">More in {tool.categoryClean}</div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                {related.map(r => (
                                    <a href={`/tools/${r.slug}`} class="td-card group block" style="padding: 14px 16px;">
                                        <div class="text-[15px] font-medium text-white group-hover:bg-gradient-to-r group-hover:from-[#a78bfa] group-hover:via-[#22d3ee] group-hover:to-[#a78bfa] group-hover:bg-clip-text group-hover:text-transparent transition-all">{r.enriched?.name ?? r.name}</div>
                                        <div class="text-[12px] font-mono text-[#525252] uppercase tracking-wide mt-0.5">{r.enriched?.company ?? r.company}</div>
                                    </a>
                                ))}
                            </div>
                            {showAlternativesLink && (
                                <a href={`/tools/${tool.slug}/alternatives`} class="inline-flex items-center gap-2 mt-4 text-[14px] font-medium text-[#c9aa6e] hover:text-[#e2c48a] transition-colors">
                                    See all {displayName} alternatives
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </a>
                            )}
                        </section>
                    )}

                    {comparisons.length > 0 && (
                        <section class="td-section" aria-label={`Compare ${displayName}`}>
                            <div class="td-section-label">Compare {displayName}</div>
                            <div class="flex flex-wrap gap-2">
                                {comparisons.map(c => (
                                    <a href={`/compare/${c.slug}`} class="inline-flex items-center gap-2 px-3 py-1.5 border border-[#222] rounded-full bg-white/5 font-mono text-[12px] text-[#a3a3a3] tracking-wide hover:text-white hover:border-[#444] transition-colors">
                                        {c.label}
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    <div class="py-6">
                        <a href="/" class="inline-flex items-center gap-2 text-[14px] text-[#737373] hover:text-white transition-colors">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            Back to directory
                        </a>
                    </div>

                    <div class="td-section" style="padding-top: 0;">
                        <div class="flex items-start gap-3 py-4 px-4 border border-[#222] rounded-lg bg-white/[0.02]">
                            <svg class="w-5 h-5 text-[#737373] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <p class="text-[13px] text-[#737373] leading-relaxed">
                                Content on this page is AI-generated. Please verify details with the vendor's website for accuracy.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

    <!-- Client scripts for auth + sidebar toggle (shared with all pages) -->
    <script src="/dist/app.js" type="module" defer></script>
</BaseLayout>
