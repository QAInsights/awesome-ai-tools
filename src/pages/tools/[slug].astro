---
/**
 * Dynamic tool detail page - [slug].astro
 *
 * Thin wrapper: renders the shared ToolDetail component (which holds the
 * template + derived data) for the English locale. The zh mirror lives at
 * src/pages/zh/tools/[slug].astro and reuses the same component.
 */
import ToolDetail from '../../components/pages/ToolDetail.astro';
import { getAllTools, type Tool } from '../../lib/tools';

export async function getStaticPaths() {
    const tools = getAllTools();
    return tools.map(tool => ({
        params: { slug: tool.slug },
        props: { tool },
    }));
}

interface Props {
    tool: Tool;
}

const { tool } = Astro.props;
---

<ToolDetail tool={tool} lang="en" />
